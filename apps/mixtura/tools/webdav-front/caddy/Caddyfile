# Caddy in front of a WebDAV server that does not answer CORS (README.md).
# {$ALLOWED_ORIGINS_REGEX}, {$BACKEND} and {$SITE_ADDRESS} come from the environment.
# A site address that is a domain name makes Caddy fetch a certificate for it.
{$SITE_ADDRESS} {
	@cors header_regexp cors Origin {$ALLOWED_ORIGINS_REGEX}
	@preflight {
		method OPTIONS
		header Access-Control-Request-Method *
		header_regexp cors Origin {$ALLOWED_ORIGINS_REGEX}
	}

	header @cors {
		Access-Control-Allow-Origin {http.request.header.Origin}
		Access-Control-Allow-Methods "GET, PUT, MKCOL, OPTIONS"
		Access-Control-Allow-Headers "Authorization, Content-Type, If-Match, If-None-Match"
		Access-Control-Expose-Headers ETag
		Access-Control-Max-Age 600
	}
	header Vary Origin

	# The browser sends no credentials on a preflight: answer it here.
	respond @preflight 204

	reverse_proxy {$BACKEND}
}
