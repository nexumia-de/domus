# nginx in front of a WebDAV server that does not answer CORS (README.md).
# The image fills in ${ALLOWED_ORIGINS_REGEX} and ${BACKEND} from the environment.

# The page's origin when it is allowed, empty otherwise. An empty header value
# makes add_header send nothing, so every header below depends on this one.
map $http_origin $cors_origin {
    default "";
    "~${ALLOWED_ORIGINS_REGEX}" $http_origin;
}
map $cors_origin $cors_methods {
    default "";
    "~." "GET, PUT, MKCOL, OPTIONS";
}
map $cors_origin $cors_headers {
    default "";
    "~." "Authorization, Content-Type, If-Match, If-None-Match";
}
map $cors_origin $cors_expose {
    default "";
    "~." "ETag";
}
map $cors_origin $cors_max_age {
    default "";
    "~." "600";
}
# A preflight is an OPTIONS request that names the method it asks about.
map "$request_method:$http_access_control_request_method" $is_preflight {
    default 0;
    "~^OPTIONS:.+" 1;
}

server {
    listen 80;
    server_name _;
    client_max_body_size 10m;

    # "always" puts them on the 401, 404, 409 and 412 answers too.
    add_header Access-Control-Allow-Origin $cors_origin always;
    add_header Access-Control-Allow-Methods $cors_methods always;
    add_header Access-Control-Allow-Headers $cors_headers always;
    add_header Access-Control-Expose-Headers $cors_expose always;
    add_header Access-Control-Max-Age $cors_max_age always;
    add_header Vary Origin always;

    location / {
        # The browser sends no credentials on a preflight: answer it here.
        if ($is_preflight) {
            return 204;
        }
        proxy_pass ${BACKEND};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Whatever CORS headers the backend sends would be a second copy.
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Methods;
        proxy_hide_header Access-Control-Allow-Headers;
        proxy_hide_header Access-Control-Expose-Headers;
        proxy_hide_header Access-Control-Max-Age;
        proxy_hide_header Vary;
        proxy_request_buffering on;
    }
}
