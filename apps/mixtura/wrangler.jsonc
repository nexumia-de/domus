{
  // Cloudflare Workers static assets: the built app, no worker script
  // (docs/deployment.md). The custom domain mixtura.nexumia.de is attached in the
  // Cloudflare dashboard, not here.
  "name": "mixtura",
  "compatibility_date": "2026-01-19",
  "assets": {
    "directory": "./packages/app/dist",
    // Not "single-page-application": the app is a hash router, every screen is
    // the one page `/` plus a #fragment the server never sees. A path that is
    // no file is a mistake, so it answers 404 instead of a 200 with the app.
    "not_found_handling": "none",
  },
  // Pull request previews (`wrangler preview`); the Preview needs no settings of its own.
  "previews": {},
}
