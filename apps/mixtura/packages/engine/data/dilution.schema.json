{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mixtura dilution parameters",
  "description": "Water added by each method as a fraction of the pre-dilution volume (docs/balance.md).",
  "type": "object",
  "required": ["version", "methods"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "methods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "fraction_low", "fraction_default", "fraction_high", "evidence"],
        "additionalProperties": false,
        "properties": {
          "id": { "enum": ["none", "stir", "shake", "build", "blend"] },
          "fraction_low": { "type": "number", "minimum": 0 },
          "fraction_default": { "type": "number", "minimum": 0 },
          "fraction_high": { "type": "number", "minimum": 0 },
          "evidence": { "enum": ["derived", "secondary", "assumption"] }
        }
      }
    }
  }
}
