{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mixtura engine test vector",
  "description": "One worked example. inputs.kind selects the rule; expected holds the numbers the engine must reproduce within tolerance (absolute, applied to every number).",
  "type": "object",
  "required": ["id", "description", "inputs", "expected", "tolerance", "source"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "description": { "type": "string" },
    "inputs": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "method", "dilution_fraction", "lines"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "balance" },
            "method": { "enum": ["none", "stir", "shake", "build", "blend"] },
            "dilution_fraction": { "type": "number", "minimum": 0 },
            "lines": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["name", "ml", "abv_pct", "sugar_g_per_100ml", "acid_pct"],
                "additionalProperties": false,
                "properties": {
                  "name": { "type": "string" },
                  "ml": { "type": "number", "minimum": 0 },
                  "abv_pct": { "type": "number", "minimum": 0 },
                  "sugar_g_per_100ml": { "type": "number", "minimum": 0 },
                  "acid_pct": { "type": "number", "minimum": 0 },
                  "sugar_g": { "type": "number", "minimum": 0 }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": ["kind", "sugar_g", "water_g", "density_g_per_ml"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "prepared_by_mass" },
            "sugar_g": { "type": "number", "minimum": 0 },
            "water_g": { "type": "number", "minimum": 0 },
            "density_g_per_ml": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      ]
    },
    "expected": {
      "type": "object",
      "additionalProperties": { "type": ["number", "null"] }
    },
    "tolerance": { "type": "number", "exclusiveMinimum": 0 },
    "source": { "type": "string" }
  }
}
