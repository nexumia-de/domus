      "input": {
        "value": 1.5,
        "unit": "oz_us"
      },
      "expected": {
        "text": "44 ml"
      }
    },
    {
      "name": "0.75 oz_us metric",
      "input": {
        "value": 0.75,
        "unit": "oz_us"
      },
      "expected": {
        "text": "22 ml"
