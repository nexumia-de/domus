{
  "id": "format-counted",
  "description": "Counted units are shown to the nearest half (refined by an eighth so a count never shows as 0), as a mixed number, the same in every display system; plural for anything but 1",
  "kind": "format",
  "cases": [
    {
      "name": "1 whole metric",
      "input": {
        "value": 1,
        "unit": "whole",
        "system": "metric"
      },
      "expected": {
        "text": "1 whole"
      }
    },
    {
      "name": "1 whole us",
      "input": {
        "value": 1,
        "unit": "whole",
        "system": "us"
      },
      "expected": {
        "text": "1 whole"
      }
    },
