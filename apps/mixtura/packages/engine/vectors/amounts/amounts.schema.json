{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mixtura amounts test vector file",
  "description": "A family of worked cases for the amounts module. Same envelope as vectors/vector.schema.json (id, description, tolerance, source); the cases array replaces inputs and expected because one rule has many examples. kind selects how the runner reads each case. Numbers in expected match within tolerance (absolute).",
  "type": "object",
  "required": ["id", "description", "kind", "cases", "tolerance", "source"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "description": { "type": "string" },
    "kind": { "enum": ["parse", "convert", "scale", "format"] },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "input", "expected"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "input": { "type": "object" },
          "expected": { "type": "object" }
        }
      }
    },
    "tolerance": { "type": "number", "exclusiveMinimum": 0 },
    "source": { "type": "string" }
  }
}
