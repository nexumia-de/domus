{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vector for variant suggestions (docs/templates.md)",
  "type": "object",
  "required": ["id", "kind", "description", "source", "lines", "expected"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "kind": {
      "const": "variants"
    },
    "description": {
      "type": "string",
      "pattern": "."
    },
    "source": {
      "type": "string",
      "pattern": "."
    },
    "templateId": {
      "type": "string"
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "expected": {
      "type": "object"
    }
  }
}
