{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mixtura:export",
  "title": "Export file",
  "description": "Everything the user entered that is Mixtura's own, as one file; format version 3. Stock is not in it: it is kept with the space.",
  "type": "object",
  "properties": {
    "app": {
      "const": "mixtura"
    },
    "formatVersion": {
      "const": 3
    },
    "exportedAt": {
      "$ref": "urn:mixtura:common#/$defs/timestamp"
    },
    "seedVersion": {
      "type": "string",
      "minLength": 1
    },
    "ingredients": {
      "type": "array",
      "items": {
        "$ref": "urn:mixtura:ingredient"
      }
    },
    "templates": {
      "type": "array",
      "items": {
        "$ref": "urn:mixtura:template"
      }
    },
    "specs": {
      "type": "array",
      "items": {
        "$ref": "urn:mixtura:spec"
      }
    },
    "affinities": {
      "type": "array",
      "items": {
        "$ref": "urn:mixtura:affinity"
      }
    }
  },
  "required": [
    "app",
    "formatVersion",
    "exportedAt",
    "ingredients",
    "templates",
    "specs",
    "affinities"
  ],
  "additionalProperties": false
}
