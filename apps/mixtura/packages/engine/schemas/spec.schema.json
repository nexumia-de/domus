{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mixtura:spec",
  "title": "Spec",
  "description": "One version of a drink: lines of ingredient, amount and unit, with method, glass and garnish.",
  "type": "object",
  "properties": {
    "id": { "$ref": "urn:mixtura:common#/$defs/id" },
    "lineageId": { "$ref": "urn:mixtura:common#/$defs/id" },
    "version": { "type": "integer", "minimum": 1 },
    "parentId": { "$ref": "urn:mixtura:common#/$defs/id" },
    "name": { "type": "string", "minLength": 1 },
    "templateId": { "$ref": "urn:mixtura:common#/$defs/id" },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "ingredientId": { "$ref": "urn:mixtura:common#/$defs/id" },
          "amount": { "$ref": "urn:mixtura:common#/$defs/amount" },
          "amountMax": { "$ref": "urn:mixtura:common#/$defs/amount" },
          "unit": { "$ref": "urn:mixtura:common#/$defs/unitId" },
          "role": { "$ref": "urn:mixtura:common#/$defs/role" },
          "topMl": {
            "description": "Volume in ml of a line whose unit is top (\"top with 90 ml\"); balance counts it only when given.",
            "type": "number",
            "minimum": 0
          },
          "optional": { "type": "boolean" },
          "note": { "type": "string" },
          "substitutes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ingredientId": { "$ref": "urn:mixtura:common#/$defs/id" },
                "amount": { "$ref": "urn:mixtura:common#/$defs/amount" },
                "unit": { "$ref": "urn:mixtura:common#/$defs/unitId" }
              },
              "required": ["ingredientId"],
              "dependentRequired": { "amount": ["unit"], "unit": ["amount"] },
              "additionalProperties": false
            }
          }
        },
        "required": ["ingredientId", "amount", "unit"],
        "if": { "properties": { "topMl": true }, "required": ["topMl"] },
        "then": { "properties": { "unit": { "const": "top" } } },
        "additionalProperties": false
      }
    },
    "method": { "$ref": "urn:mixtura:common#/$defs/id" },
    "glass": { "$ref": "urn:mixtura:common#/$defs/id" },
    "garnish": { "type": "string" },
    "notes": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "status": { "enum": ["draft", "on-menu", "retired"] },
    "note": {
      "description": "One line the user wrote when saving this version: what changed and why.",
      "type": "string"
    },
    "statusLog": {
      "description": "Every change of status, oldest first; a change of status is not a new version.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "status": { "enum": ["draft", "on-menu", "retired"] },
          "at": { "$ref": "urn:mixtura:common#/$defs/timestamp" }
        },
        "required": ["status", "at"],
        "additionalProperties": false
      }
    },
    "source": { "$ref": "urn:mixtura:common#/$defs/source" },
    "createdAt": { "$ref": "urn:mixtura:common#/$defs/timestamp" },
    "updatedAt": { "$ref": "urn:mixtura:common#/$defs/timestamp" }
  },
  "required": ["id", "lineageId", "version", "name", "lines", "status"],
  "additionalProperties": false
}
