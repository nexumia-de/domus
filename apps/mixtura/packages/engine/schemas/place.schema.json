{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mixtura:place",
  "title": "Place",
  "description": "A place where ingredients are kept, such as a home bar or a cabin; stock is kept per place.",
  "type": "object",
  "properties": {
    "id": { "$ref": "urn:mixtura:common#/$defs/id" },
    "name": { "type": "string", "minLength": 1 },
    "updatedAt": { "$ref": "urn:mixtura:common#/$defs/timestamp" }
  },
  "required": ["id", "name", "updatedAt"],
  "additionalProperties": false
}
