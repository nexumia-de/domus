{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mixtura:binding",
  "title": "Binding",
  "description": "Where one synced unit of this device is stored: a storage, a folder in it and the passphrase of the unit. Device-local: never in the export file, a sync file or an invite, so it is not part of the export schema.",
  "type": "object",
  "properties": {
    "unitKind": { "const": "place" },
    "unitId": { "$ref": "urn:mixtura:common#/$defs/id" },
    "storageId": { "$ref": "urn:mixtura:common#/$defs/id" },
    "folder": { "type": "string", "minLength": 1 },
    "passphrase": { "type": "string", "minLength": 1 },
    "etag": { "type": "string", "minLength": 1 },
    "lastSyncAt": { "$ref": "urn:mixtura:common#/$defs/timestamp" },
    "lastError": { "type": "string" }
  },
  "required": ["unitKind", "unitId", "storageId", "folder", "passphrase"],
  "additionalProperties": false
}
