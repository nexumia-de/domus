{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mixtura:storage",
  "title": "Storage",
  "description": "A storage the user configured on this device for sync, with its credentials. Device-local: never in the export file, a sync file or an invite, so it is not part of the export schema.",
  "type": "object",
  "properties": {
    "id": { "$ref": "urn:mixtura:common#/$defs/id" },
    "label": { "type": "string", "minLength": 1 },
    "type": { "const": "webdav" },
    "baseUrl": { "type": "string", "pattern": "^https?://[^\\s]+$" },
    "username": { "type": "string" },
    "password": { "type": "string" }
  },
  "required": ["id", "label", "type", "baseUrl"],
  "additionalProperties": false
}
