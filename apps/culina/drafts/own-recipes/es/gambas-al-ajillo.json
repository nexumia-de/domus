      "steps": [
        {
          "text": {
            "en": "Pat the prawns dry and sprinkle them with the salt. Cut the garlic into thin slices.",
            "de": "Die Garnelen trocken tupfen und mit dem Salz bestreuen. Den Knoblauch in dünne Scheiben schneiden."
          },
          "action": "dry",
          "uses": ["prawns", "salt", "garlic"]
        },
        {
          "text": {
            "en": "Put the oil, the garlic and the cayenne into a wide pan and heat them over medium heat until the garlic just begins to colour.",
            "de": "Öl, Knoblauch und Cayennepfeffer in eine weite Pfanne geben und bei mittlerer Hitze erhitzen, bis der Knoblauch gerade Farbe annimmt."
          },
          "action": "heat",
          "uses": ["oil", "garlic", "cayenne"],
          "time": {
            "value": 2,
            "to": 3,
            "unit": "min"
          }
        },
        {
          "text": {
            "en": "Add the prawns in one layer and cook them, turning once, until they are pink all through.",
            "de": "Die Garnelen in einer Lage dazugeben und unter einmaligem Wenden garen, bis sie durchgehend rosa sind."
          },
          "action": "cook",
          "uses": ["prawns"],
          "time": {
            "value": 2,
            "to": 3,
            "unit": "min"
          }
        },
        {
          "text": {
            "en": "Sprinkle with the parsley.",
            "de": "Mit der Petersilie bestreuen."
          },
          "action": "sprinkle",
          "uses": ["parsley"]
        },
        {
          "text": {
            "en": "Serve at once in the hot oil, with bread to dip into it.",
            "de": "Sofort im heißen Öl servieren, dazu Brot zum Tunken."
          },
          "action": "serve"
        }
      ]
    }
