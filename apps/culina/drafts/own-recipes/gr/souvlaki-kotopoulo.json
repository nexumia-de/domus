      "steps": [
        {
          "text": {
            "en": "Cut the chicken into cubes of about 3 cm.",
            "de": "Das Hähnchenfleisch in etwa 3 cm große Würfel schneiden."
          },
          "technique": "knife-cuts",
          "uses": ["chicken"]
        },
        {
          "text": {
            "en": "Chop the garlic finely and mix it in a bowl with the olive oil, the lemon juice, the salt and the pepper.",
            "de": "Den Knoblauch fein hacken und in einer Schüssel mit Olivenöl, Zitronensaft, Salz und Pfeffer mischen."
          },
          "action": "mix",
          "uses": ["garlic", "oil", "lemon", "salt", "pepper"]
        },
        {
          "text": {
            "en": "Turn the chicken in the marinade, cover it and leave it in the refrigerator for 1 to 2 hours.",
            "de": "Das Fleisch in der Marinade wenden, zudecken und 1 bis 2 Stunden im Kühlschrank ziehen lassen."
          },
          "technique": "marinate",
          "uses": ["chicken"],
          "time": {
            "value": 1,
            "to": 2,
            "unit": "h"
          }
        },
        {
          "text": {
            "en": "Thread the cubes onto 8 skewers, not pressed tightly together. Wooden skewers are soaked in water beforehand.",
            "de": "Die Würfel auf 8 Spieße stecken, nicht fest aneinandergedrückt. Holzspieße vorher in Wasser einweichen."
          },
          "action": "prepare",
          "uses": ["chicken"]
        },
        {
          "text": {
            "en": "Grill the skewers over high heat, or cook them in a hot grill pan, for 10 to 12 minutes. Turn them every few minutes, until the meat is browned on all sides and cooked through.",
            "de": "Die Spieße bei starker Hitze auf dem Grill oder in einer heißen Grillpfanne 10 bis 12 Minuten garen. Alle paar Minuten wenden, bis das Fleisch rundum gebräunt und durchgegart ist."
          },
          "action": "grill",
          "uses": ["chicken"],
          "time": {
            "value": 10,
            "to": 12,
            "unit": "min"
          }
        }
      ]
    }
