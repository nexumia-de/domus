      "steps": [
        {
          "text": {
            "en": "Blend the tomatoes, the onion and the garlic to a smooth purée.",
            "de": "Tomaten, Zwiebel und Knoblauch im Mixer glatt pürieren."
          },
          "action": "puree",
          "uses": ["tomato", "onion", "garlic"]
        },
        {
          "text": {
            "en": "Heat the oil in a pot with a lid and fry the dry rice over medium heat, stirring, until it is pale gold.",
            "de": "Das Öl in einem Topf mit Deckel erhitzen und den trockenen Reis bei mittlerer Hitze unter Rühren hellgolden anbraten."
          },
          "action": "toast",
          "uses": ["oil", "rice"],
          "time": {
            "value": 5,
            "unit": "min"
          }
        },
        {
          "text": {
            "en": "Pour in the tomato purée and cook, stirring, until most of it has been taken up.",
            "de": "Das Tomatenpüree zugießen und unter Rühren garen, bis es größtenteils aufgenommen ist."
          },
          "action": "pour",
          "uses": ["tomato"],
          "time": {
            "value": 2,
            "unit": "min"
          }
        },
        {
          "text": {
            "en": "Add the water and the salt and bring to the boil.",
            "de": "Wasser und Salz zugeben und aufkochen."
          },
          "action": "add",
          "uses": ["water", "salt"]
        },
        {
          "text": {
            "en": "Put the lid on and cook over the lowest heat without stirring.",
            "de": "Den Deckel auflegen und bei kleinster Hitze garen, ohne zu rühren."
          },
          "technique": "cook-rice",
          "time": {
            "value": 15,
            "unit": "min"
          }
        },
        {
          "text": {
            "en": "Take the pot off the heat and let the rice stand with the lid on.",
            "de": "Den Topf vom Herd nehmen und den Reis zugedeckt stehen lassen."
          },
          "action": "stand",
          "time": {
            "value": 10,
            "unit": "min"
          }
        },
        {
          "text": {
            "en": "Loosen the rice with a fork.",
            "de": "Den Reis mit einer Gabel auflockern."
          },
          "action": "stir",
          "uses": ["rice"]
        }
      ]
    }
