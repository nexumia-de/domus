      "steps": [
        {
          "text": {
            "en": "Heat the oil in a wide pot over medium heat.",
            "de": "Das Öl in einem breiten Topf bei mittlerer Hitze erhitzen."
          },
          "action": "heat",
          "uses": ["oil"]
        },
        {
          "text": {
            "en": "Cook the onions in it for 12 minutes, stirring often, until golden brown.",
            "de": "Die Zwiebeln darin unter häufigem Rühren 12 Minuten goldbraun braten."
          },
          "action": "cook",
          "uses": ["onion"],
          "time": {
            "value": 12,
            "unit": "min"
          }
        },
        {
          "text": {
            "en": "Add the garlic and the ginger and stir for 1 minute.",
            "de": "Knoblauch und Ingwer dazugeben und 1 Minute rühren."
          },
          "action": "add",
          "uses": ["garlic", "ginger"],
          "time": {
            "value": 1,
            "unit": "min"
          }
        },
        {
          "text": {
            "en": "Stir in the ground coriander, the turmeric and the cayenne pepper for 30 seconds.",
            "de": "Gemahlenen Koriander, Kurkuma und Cayennepfeffer 30 Sekunden einrühren."
          },
          "action": "season",
          "uses": ["coriander-seed", "turmeric", "cayenne"],
          "time": {
            "value": 30,
            "unit": "s"
          }
        },
        {
          "text": {
            "en": "Add the tomatoes and the salt and cook for 10 minutes, stirring now and then, until the tomatoes have broken down into a thick sauce and the oil shows at the edge.",
            "de": "Tomaten und Salz dazugeben und unter gelegentlichem Rühren 10 Minuten garen, bis die Tomaten zu einer dicken Sauce zerfallen sind und sich am Rand das Öl zeigt."
          },
          "action": "cook",
          "uses": ["tomato", "salt"],
          "time": {
            "value": 10,
            "unit": "min"
          }
        }
      ]
    },
    {
      "id": "murgh-chicken",
      "name": {
        "en": "Chicken",
        "de": "Hähnchen"
      },
      "role": "main",
      "lines": [
        {
          "key": "chicken",
          "ref": {
