          "amount": {
            "value": 600,
            "unit": "g"
          },
          "note": {
            "en": "Thigh meat without bone and skin, in pieces of about 3 cm.",
            "de": "Keulenfleisch ohne Knochen und Haut, in etwa 3 cm großen Stücken."
          }
        },
        {
          "key": "water",
          "wanted": {
            "en": "Water",
            "de": "Wasser"
          },
          "amount": {
            "value": 200,
            "unit": "ml"
          }
        },
        {
          "key": "coriander",
          "ref": {
            "kind": "ingredient",
            "id": "fdc-169997"
          },
          "amount": {
            "value": 10,
            "unit": "g"
          },
          "note": {
            "en": "Chopped.",
            "de": "Gehackt."
          }
        }
      ],
      "steps": [
        {
          "text": {
            "en": "Add the chicken to the sauce and stir over medium heat for 5 minutes until the pieces are coated and no longer pink on the outside.",
            "de": "Das Hähnchen in die Sauce geben und bei mittlerer Hitze 5 Minuten rühren, bis die Stücke überzogen und außen nicht mehr rosa sind."
          },
          "action": "add",
          "uses": ["chicken"],
          "time": {
            "value": 5,
            "unit": "min"
          }
        },
        {
          "text": {
            "en": "Pour in the water, bring to the boil, cover and simmer gently for 20 minutes until the chicken is cooked through.",
            "de": "Das Wasser zugießen, aufkochen, zudecken und 20 Minuten leise köcheln lassen, bis das Hähnchen durchgegart ist."
          },
          "technique": "simmer",
          "uses": ["water"],
          "time": {
            "value": 20,
            "unit": "min"
          }
        },
        {
          "text": {
            "en": "Take the lid off and let the sauce cook down for 5 minutes until it coats the meat.",
            "de": "Den Deckel abnehmen und die Sauce 5 Minuten einkochen lassen, bis sie das Fleisch überzieht."
          },
          "technique": "reduce",
          "time": {
            "value": 5,
            "unit": "min"
          }
        },
        {
          "text": {
            "en": "Scatter the coriander leaves on top and serve with rice or flatbread.",
            "de": "Das Koriandergrün darüberstreuen und mit Reis oder Fladenbrot anrichten."
          },
          "action": "serve",
          "uses": ["coriander"]
        }
      ]
    }
