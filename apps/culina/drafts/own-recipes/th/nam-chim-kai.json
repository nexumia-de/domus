      "steps": [
        {
          "text": {
            "en": "Chop the chillies and the garlic very finely, or crush them coarsely in a mortar.",
            "de": "Chilis und Knoblauch sehr fein hacken oder im Mörser grob zerstoßen."
          },
          "action": "crush",
          "uses": ["chili", "garlic"]
        },
        {
          "text": {
            "en": "Put them into a small pot with the vinegar, the water, the sugar and the salt and bring to the boil, stirring, until the sugar has dissolved.",
            "de": "Mit Essig, Wasser, Zucker und Salz in einen kleinen Topf geben und unter Rühren aufkochen, bis sich der Zucker gelöst hat."
          },
          "action": "heat",
          "uses": ["vinegar", "water", "sugar", "salt"]
        },
        {
          "text": {
            "en": "Simmer without a lid for 10 minutes until the sauce is lightly syrupy; it thickens further as it cools.",
            "de": "Ohne Deckel 10 Minuten köcheln lassen, bis die Sauce leicht sirupartig ist; beim Abkühlen dickt sie weiter ein."
          },
          "technique": "reduce",
          "time": {
            "value": 10,
            "unit": "min"
          }
        },
        {
          "text": {
            "en": "Let the sauce cool and fill it into a clean jar. It keeps in the refrigerator for 2 weeks.",
            "de": "Die Sauce abkühlen lassen und in ein sauberes Glas füllen. Im Kühlschrank hält sie sich 2 Wochen."
          },
          "action": "cool"
        }
      ]
    }
