      "steps": [
        {
          "text": {
            "en": "Chop the onion finely. Melt the butter with the olive oil in a pot and cook the onion in it over medium heat for about 5 minutes, until soft and without colour.",
            "de": "Die Zwiebel fein würfeln. Die Butter mit dem Olivenöl in einem Topf schmelzen und die Zwiebel darin bei mittlerer Hitze etwa 5 Minuten weich dünsten, ohne dass sie Farbe nimmt."
          },
          "technique": "sweat",
          "uses": ["onion", "butter", "oil"],
          "time": {
            "value": 5,
            "unit": "min"
          }
        },
        {
          "text": {
            "en": "Stir in the tomato paste and cook it for 1 minute.",
            "de": "Das Tomatenmark einrühren und 1 Minute mitdünsten."
          },
          "action": "stir",
          "uses": ["paste"],
          "time": {
            "value": 1,
            "unit": "min"
          }
        },
        {
          "text": {
            "en": "Add the bulgur and stir for 1 minute, until every grain is coated.",
            "de": "Den Bulgur dazugeben und 1 Minute rühren, bis alle Körner überzogen sind."
          },
          "action": "add",
          "uses": ["bulgur"],
          "time": {
            "value": 1,
            "unit": "min"
          }
        },
        {
          "text": {
            "en": "Pour in the hot water, add the salt and the pepper and bring to the boil.",
            "de": "Das heiße Wasser angießen, Salz und Pfeffer dazugeben und aufkochen."
          },
          "action": "pour",
          "uses": ["water", "salt", "pepper"]
        },
        {
          "text": {
            "en": "Cover and cook over the lowest heat for 12 to 15 minutes, without stirring, until the bulgur has taken up the water.",
            "de": "Zugedeckt bei schwächster Hitze 12 bis 15 Minuten garen, ohne zu rühren, bis der Bulgur das Wasser aufgenommen hat."
          },
          "action": "cook",
          "time": {
            "value": 12,
            "to": 15,
            "unit": "min"
          }
        },
        {
          "text": {
            "en": "Take the pot off the heat, lay a clean kitchen towel under the lid and let the bulgur stand for 10 minutes. Loosen it with a fork.",
            "de": "Den Topf vom Herd nehmen, ein sauberes Küchentuch unter den Deckel legen und den Bulgur 10 Minuten stehen lassen. Mit einer Gabel auflockern."
          },
          "action": "stand",
          "time": {
            "value": 10,
            "unit": "min"
          }
        }
      ]
