{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexumia-de.github.io/culina/schemas/handling.schema.json",
  "title": "Handling rule",
  "description": "When an ingredient goes into a dish and how it is treated, with the reason: shipped read-only, one file per rule. Hangs on one catalogue ingredient or group and on one technique (a skill, so the rule fades when it is learned). Never stored. Every statement names what it rests on.",
  "type": "object",
  "required": ["id", "target", "text", "why", "technique", "level", "sources"],
  "additionalProperties": false,
  "patternProperties": {
    "^x-": true
  },
  "properties": {
    "id": {
      "$ref": "https://nexumia-de.github.io/culina/schemas/common.schema.json#/$defs/id"
    },
    "target": {
      "description": "A catalogue ingredient id, or a catalogue group id: the rule then applies to every ingredient under the group.",
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "text": {
      "$ref": "https://nexumia-de.github.io/culina/schemas/common.schema.json#/$defs/i18nText"
    },
    "why": {
      "$ref": "https://nexumia-de.github.io/culina/schemas/common.schema.json#/$defs/i18nText"
    },
    "technique": {
      "$ref": "https://nexumia-de.github.io/culina/schemas/common.schema.json#/$defs/id"
    },
    "level": {
      "enum": ["studied", "textbook", "tested", "authority", "tradition"]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "place", "sentence"],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "place": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "url": {
            "type": "string",
            "pattern": "^https?://\\S+$",
            "maxLength": 500
          },
          "isbn": {
            "description": "The ISBN-13 of the edition read, digits only: a printed book has no page to link to. A source has a url or an isbn.",
            "type": "string",
            "pattern": "^97[89][0-9]{10}$"
          },
          "licence": {
            "description": "The licence of the work, as an SPDX identifier (CC-BY-NC-SA-4.0). Every shipped source with a url has one; a build that leaves out what is non-commercial reads it. A book cited by isbn has none: it is cited as fact, nothing of it is reused.",
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]*$",
            "maxLength": 100
          },
          "level": {
            "description": "How this source knows it, when that differs from the level of the note: a kitchen test cited beside a textbook.",
            "enum": ["studied", "textbook", "tested", "authority", "tradition"]
          },
          "sentence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        },
        "anyOf": [
          {
            "required": ["url"]
          },
          {
            "required": ["isbn"]
          }
        ]
      }
    }
  }
}
