{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexumia-de.github.io/culina/schemas/ingredient.schema.json",
  "title": "Ingredient",
  "description": "A node of the ingredient tree (category or variety) with kitchen properties. Properties left out are inherited from the parent.",
  "type": "object",
  "required": ["id", "name"],
  "additionalProperties": false,
  "patternProperties": { "^x-": true },
  "properties": {
    "id": { "$ref": "https://nexumia-de.github.io/culina/schemas/common.schema.json#/$defs/id" },
    "name": {
      "$ref": "https://nexumia-de.github.io/culina/schemas/common.schema.json#/$defs/name"
    },
    "parentId": {
      "$ref": "https://nexumia-de.github.io/culina/schemas/common.schema.json#/$defs/id"
    },
    "names": {
      "description": "Names in other languages, keyed by language tag. `name` stays the canonical English name; these are searched and shown beside it.",
      "type": "object",
      "propertyNames": { "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
      "additionalProperties": {
        "type": "object",
        "required": ["name", "source"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "$ref": "https://nexumia-de.github.io/culina/schemas/common.schema.json#/$defs/name"
          },
          "aliases": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "https://nexumia-de.github.io/culina/schemas/common.schema.json#/$defs/name"
            }
          },
          "source": {
            "$ref": "https://nexumia-de.github.io/culina/schemas/common.schema.json#/$defs/source"
          }
        }
      }
    },
    "roles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "https://nexumia-de.github.io/culina/schemas/common.schema.json#/$defs/roleId"
      }
    },
    "season": {
      "type": "object",
      "required": ["months", "source"],
      "additionalProperties": false,
      "properties": {
        "months": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 12 }
        },
        "region": {
          "$ref": "https://nexumia-de.github.io/culina/schemas/common.schema.json#/$defs/text"
        },
        "source": {
          "$ref": "https://nexumia-de.github.io/culina/schemas/common.schema.json#/$defs/source"
        }
      }
    },
    "allergens": {
      "description": "Reserved for issue 27: the 14 substances of Annex II of Regulation (EU) 1169/2011, declared by data, never derived.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "gluten",
          "crustaceans",
          "eggs",
          "fish",
          "peanuts",
          "soybeans",
          "milk",
          "nuts",
          "celery",
          "mustard",
          "sesame",
          "sulphites",
          "lupin",
          "molluscs"
        ]
      }
    },
    "yields": {
      "description": "Weight of the food in a state as a percentage of the weight as purchased. Above 100 is possible (cooked rice).",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["state", "percent", "source"],
        "additionalProperties": false,
        "properties": {
          "state": {
            "$ref": "https://nexumia-de.github.io/culina/schemas/common.schema.json#/$defs/state"
          },
          "percent": { "type": "number", "exclusiveMinimum": 0 },
          "source": {
            "$ref": "https://nexumia-de.github.io/culina/schemas/common.schema.json#/$defs/source"
          }
        }
      }
    },
    "shelfLife": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["state", "storage", "days", "source"],
        "additionalProperties": false,
        "properties": {
          "state": {
            "$ref": "https://nexumia-de.github.io/culina/schemas/common.schema.json#/$defs/state"
          },
          "storage": {
            "$ref": "https://nexumia-de.github.io/culina/schemas/common.schema.json#/$defs/storage"
          },
          "days": { "type": "integer", "minimum": 0 },
          "source": {
            "$ref": "https://nexumia-de.github.io/culina/schemas/common.schema.json#/$defs/source"
          }
        }
      }
    },
    "densityGPerMl": {
      "$ref": "https://nexumia-de.github.io/culina/schemas/common.schema.json#/$defs/sourcedNumber"
    },
    "unitWeightG": {
      "$ref": "https://nexumia-de.github.io/culina/schemas/common.schema.json#/$defs/sourcedNumber"
    },
    "note": { "$ref": "https://nexumia-de.github.io/culina/schemas/common.schema.json#/$defs/text" }
  }
}
