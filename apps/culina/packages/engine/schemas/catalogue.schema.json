{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexumia-de.github.io/culina/schemas/catalogue.schema.json",
  "title": "Ingredient catalogue",
  "description": "The file shipped with the app, generated by tools/catalogue/build.mjs from a public-domain dataset. Every entry is an ordinary ingredient record; the envelope says where they come from.",
  "type": "object",
  "required": ["format", "formatVersion", "dataset", "generatedBy", "ingredients"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "culina-ingredient-catalogue" },
    "formatVersion": { "const": 1 },
    "dataset": {
      "type": "object",
      "required": ["name", "release", "file", "sha256", "licence"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "https://nexumia-de.github.io/culina/schemas/common.schema.json#/$defs/text"
        },
        "release": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}(-[0-9]{2})?$" },
        "file": {
          "$ref": "https://nexumia-de.github.io/culina/schemas/common.schema.json#/$defs/text"
        },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "licence": {
          "$ref": "https://nexumia-de.github.io/culina/schemas/common.schema.json#/$defs/text"
        }
      }
    },
    "refuseDataset": {
      "description": "Where the refuse percentages of the yields come from: a second file of the same source, read by tools/catalogue/build.mjs.",
      "type": "object",
      "required": ["name", "file", "sha256", "licence"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "https://nexumia-de.github.io/culina/schemas/common.schema.json#/$defs/text"
        },
        "file": {
          "$ref": "https://nexumia-de.github.io/culina/schemas/common.schema.json#/$defs/text"
        },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "licence": {
          "$ref": "https://nexumia-de.github.io/culina/schemas/common.schema.json#/$defs/text"
        }
      }
    },
    "namesDataset": {
      "description": "Where the names in other languages come from: a snapshot file kept in the repository, read by tools/catalogue/build.mjs.",
      "type": "object",
      "required": ["name", "file", "sha256", "retrieved", "licence"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "https://nexumia-de.github.io/culina/schemas/common.schema.json#/$defs/text"
        },
        "file": {
          "$ref": "https://nexumia-de.github.io/culina/schemas/common.schema.json#/$defs/text"
        },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "retrieved": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "licence": {
          "$ref": "https://nexumia-de.github.io/culina/schemas/common.schema.json#/$defs/text"
        }
      }
    },
    "ownNamesDataset": {
      "description": "The project's own German names (a translation of the USDA descriptions, kept by hand in tools/catalogue/names-de-own.json), merged by tools/catalogue/build.mjs or tools/catalogue/merge-own-names.mjs where Wikidata has no name. `sha256` is that file's; `retrieved` is the date of the translation.",
      "type": "object",
      "required": ["name", "file", "sha256", "retrieved", "licence"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "https://nexumia-de.github.io/culina/schemas/common.schema.json#/$defs/text"
        },
        "file": {
          "$ref": "https://nexumia-de.github.io/culina/schemas/common.schema.json#/$defs/text"
        },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "retrieved": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "licence": {
          "$ref": "https://nexumia-de.github.io/culina/schemas/common.schema.json#/$defs/text"
        }
      }
    },
    "generatedBy": {
      "$ref": "https://nexumia-de.github.io/culina/schemas/common.schema.json#/$defs/text"
    },
    "ingredients": {
      "type": "array",
      "items": { "$ref": "https://nexumia-de.github.io/culina/schemas/ingredient.schema.json" }
    }
  }
}
