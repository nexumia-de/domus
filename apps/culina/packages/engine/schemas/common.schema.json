{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexumia-de.github.io/culina/schemas/common.schema.json",
  "title": "Culina common types",
  "description": "Types every Culina entity schema refers to. Not an entity itself.",
  "$defs": {
    "id": {
      "description": "Seed ids are lower-case slugs, user ids are u- plus a lower-case UUID. Never changes after creation.",
      "type": "string",
      "maxLength": 80,
      "pattern": "^([a-z0-9]+(-[a-z0-9]+)*|u-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$"
    },
    "roleId": {
      "description": "A role is data, not a closed list: ingredient roles (acid, fat, flour) and dish roles (main, sauce, crunch) share one id space.",
      "type": "string",
      "maxLength": 40,
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "date": {
      "description": "Calendar day, YYYY-MM-DD, entered or supplied by the host.",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "instant": {
      "description": "ISO 8601 UTC instant with Z, supplied by the host.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "source": {
      "description": "Where a number or entity comes from: the word user for the user's own entry, otherwise a citation.",
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "state": {
      "description": "State of food: raw as bought or picked, cooked, or prepared (a made component).",
      "enum": ["raw", "cooked", "prepared"]
    },
    "storage": { "enum": ["pantry", "fridge", "freezer"] },
    "massUnit": { "enum": ["g", "kg", "oz", "lb"] },
    "amountUnit": {
      "description": "Mass units, volume units (need a density) and count (needs a unit weight). The conversion table is part of the engine rules.",
      "enum": ["g", "kg", "oz", "lb", "ml", "l", "tsp", "tbsp", "cup", "count"]
    },
    "massAmount": {
      "type": "object",
      "required": ["value", "unit"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "$ref": "#/$defs/massUnit" }
      }
    },
    "amount": {
      "type": "object",
      "required": ["value", "unit"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "$ref": "#/$defs/amountUnit" }
      }
    },
    "lineAmount": {
      "description": "An amount, or a percentage of the component's reference mass (baker's percentage).",
      "oneOf": [
        { "$ref": "#/$defs/amount" },
        {
          "type": "object",
          "required": ["value", "unit"],
          "additionalProperties": false,
          "properties": {
            "value": { "type": "number", "exclusiveMinimum": 0 },
            "unit": { "const": "percent" }
          }
        }
      ]
    },
    "sourcedNumber": {
      "type": "object",
      "required": ["value", "source"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "number", "exclusiveMinimum": 0 },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "ref": {
      "description": "Reference to an ingredient or to a component (a sub-recipe or a made item).",
      "type": "object",
      "required": ["kind", "id"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["ingredient", "component"] },
        "id": { "$ref": "#/$defs/id" }
      }
    },
    "version": {
      "description": "Where an entity stands in its family of versions. parent in the same family is the previous version; parent in another family makes this a variation.",
      "type": "object",
      "required": ["family", "date"],
      "additionalProperties": false,
      "properties": {
        "family": { "$ref": "#/$defs/id" },
        "parent": { "$ref": "#/$defs/id" },
        "date": { "$ref": "#/$defs/date" },
        "change": { "$ref": "#/$defs/text" },
        "reason": { "$ref": "#/$defs/text" }
      }
    },
    "tastings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "text"],
        "additionalProperties": false,
        "properties": {
          "date": { "$ref": "#/$defs/date" },
          "text": { "$ref": "#/$defs/text" }
        }
      }
    }
  }
}
