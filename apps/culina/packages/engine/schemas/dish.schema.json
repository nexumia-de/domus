{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexumia-de.github.io/culina/schemas/dish.schema.json",
  "title": "Dish",
  "description": "Role slots filled by components or ingredients. One stored record is one version.",
  "type": "object",
  "required": ["id", "name", "slots", "version"],
  "additionalProperties": false,
  "patternProperties": {
    "^x-": true
  },
  "properties": {
    "id": {
      "$ref": "https://nexumia-de.github.io/culina/schemas/common.schema.json#/$defs/id"
    },
    "name": {
      "$ref": "https://nexumia-de.github.io/culina/schemas/common.schema.json#/$defs/name"
    },
    "portions": {
      "type": "integer",
      "minimum": 1
    },
    "course": {
      "description": "Where the dish sits in a meal, where the cook states it; the same list as a classic's course.",
      "$ref": "https://nexumia-de.github.io/culina/schemas/common.schema.json#/$defs/course"
    },
    "cuisine": {
      "description": "The country whose kitchen the dish belongs to, where the cook states it; a copied classic keeps its country here.",
      "$ref": "https://nexumia-de.github.io/culina/schemas/common.schema.json#/$defs/country"
    },
    "slots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "ref"],
        "additionalProperties": false,
        "properties": {
          "key": {
            "description": "Names the slot inside its dish so an assembly step can point at it; unique in the dish.",
            "$ref": "https://nexumia-de.github.io/culina/schemas/common.schema.json#/$defs/lineKey"
          },
          "role": {
            "$ref": "https://nexumia-de.github.io/culina/schemas/common.schema.json#/$defs/roleId"
          },
          "ref": {
            "$ref": "https://nexumia-de.github.io/culina/schemas/common.schema.json#/$defs/ref"
          },
          "amount": {
            "$ref": "https://nexumia-de.github.io/culina/schemas/common.schema.json#/$defs/amount"
          },
          "optional": {
            "type": "boolean"
          }
        }
      }
    },
    "steps": {
      "description": "The assembly: what is done with the fillings once they are made. A step uses slots by their key, as a step of a component uses lines.",
      "type": "array",
      "items": {
        "$ref": "https://nexumia-de.github.io/culina/schemas/common.schema.json#/$defs/step"
      }
    },
    "version": {
      "$ref": "https://nexumia-de.github.io/culina/schemas/common.schema.json#/$defs/version"
    },
    "note": {
      "$ref": "https://nexumia-de.github.io/culina/schemas/common.schema.json#/$defs/text"
    }
  }
}
