{
  "id": "anchor-removed-by-derivative",
  "description": "A derivative removes the inherited anchor role; a derivative of it that adds the role back is fine, one that does not is not",
  "inputs": {
    "kind": "validate_model",
    "model": {
      "templates": [
        {
          "id": "pie",
          "name": "pie",
          "source": "user",
          "parts": [
            {
              "role": "flour",
              "parts": 3
            },
            {
              "role": "fat",
              "parts": 2
            },
            {
              "role": "water",
              "parts": 1
            }
          ],
          "anchor": "flour"
        },
        {
          "id": "no-flour",
          "name": "no-flour",
          "source": "user",
          "parentId": "pie",
          "changes": [
            {
              "op": "remove",
              "role": "flour"
            }
          ]
        },
        {
          "id": "flour-back",
          "name": "flour-back",
          "source": "user",
          "parentId": "no-flour",
          "changes": [
            {
              "op": "add",
              "role": "flour",
              "parts": 1
            }
          ]
        },
        {
          "id": "still-none",
          "name": "still-none",
          "source": "user",
          "parentId": "no-flour",
          "changes": [
            {
              "op": "add",
              "role": "sugar",
              "parts": 1
            }
          ]
        }
      ]
    }
  },
  "expected": {
    "ok": false,
    "findings": [
      {
        "code": "anchor-not-a-role",
        "kind": "template",
        "id": "no-flour",
        "role": "flour"
      },
      {
        "code": "anchor-not-a-role",
        "kind": "template",
        "id": "still-none",
        "role": "flour"
      }
    ]
  },
  "tolerance": 0,
  "source": "docs/engine-rules.md#cross-record-validation; synthetic records written for this rule, ids chosen for readability"
}
