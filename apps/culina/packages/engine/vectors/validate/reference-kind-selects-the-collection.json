      {
        "code": "unknown-component",
        "kind": "stock",
        "id": "s1",
        "path": "ref",
        "ref": "only-ingredient"
      },
      {
        "code": "unknown-ingredient",
        "kind": "stock",
        "id": "s2",
        "path": "ref",
        "ref": "only-component"
      }
    ]
  },
  "tolerance": 0,
  "source": "docs/engine-rules.md#cross-record-validation; synthetic records written for this rule, ids chosen for readability"
}
