    "kind": "validate_model",
    "model": {
      "templates": [
        {
          "id": "dough",
          "name": "dough",
          "source": "user",
          "parts": [
            {
              "role": "flour",
              "parts": 0
            },
            {
              "role": "water",
              "parts": 1
            }
          ]
        }
      ]
    }
  },
  "expected": {
    "ok": false,
    "findings": [
      {
        "code": "invalid-parts",
        "kind": "template",
        "id": "dough",
        "path": "parts[0]",
        "role": "flour"
      }
    ]
  },
  "tolerance": 0,
  "source": "docs/engine-rules.md#cross-record-validation; synthetic records written for this rule, ids chosen for readability"
