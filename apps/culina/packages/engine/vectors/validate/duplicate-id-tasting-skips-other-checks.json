{
  "id": "duplicate-id-tasting-skips-other-checks",
  "description": "A later tasting note with an id already used gets only duplicate-id, even when its ref is unknown",
  "inputs": {
    "kind": "validate_model",
    "model": {
      "ingredients": [
        {
          "id": "salt",
          "name": "salt"
        }
      ],
      "components": [
        {
          "id": "c",
          "name": "c",
          "lines": [
            {
              "ref": {
                "kind": "ingredient",
                "id": "salt"
              }
            }
          ],
          "version": {
            "family": "c",
            "date": "2026-11-18"
          }
        }
      ],
      "tastings": [
        {
          "id": "n1",
          "ref": {
            "kind": "component",
            "id": "c"
          },
          "date": "2026-11-18",
          "text": "t"
        },
        {
          "id": "n1",
          "ref": {
            "kind": "component",
            "id": "ghost"
          },
          "date": "2026-11-18",
          "text": "t"
        }
      ]
    }
  },
  "expected": {
    "ok": false,
    "findings": [
      {
        "code": "duplicate-id",
        "kind": "tasting",
        "id": "n1"
      }
    ]
  },
  "tolerance": 0,
  "source": "docs/engine-rules.md#cross-record-validation; synthetic records written for this rule, ids chosen for readability"
}
