{
  "id": "resolve-changes-in-order",
  "description": "Changes apply in order: removing a role and adding it again puts it last with the new parts",
  "inputs": {
    "kind": "resolve_template",
    "templates": [
      {
        "id": "pie",
        "name": "pie",
        "source": "user",
        "parts": [
          {
            "role": "flour",
            "parts": 3
          },
          {
            "role": "fat",
            "parts": 2
          },
          {
            "role": "water",
            "parts": 1
          }
        ],
        "anchor": "flour"
      },
      {
        "id": "more-water",
        "name": "more-water",
        "source": "user",
        "parentId": "pie",
        "changes": [
          {
            "op": "remove",
            "role": "water"
          },
          {
            "op": "add",
            "role": "water",
            "parts": 2
          }
        ]
      }
    ],
    "id": "more-water"
  },
  "expected": {
    "roles": ["flour", "fat", "water"],
    "parts": {
      "flour": 3,
      "fat": 2,
      "water": 2
    },
    "lineage": ["pie", "more-water"],
    "anchor": "flour"
  },
  "tolerance": 1e-6,
  "source": "remove water, then add water 2; synthetic template numbers chosen for the arithmetic, not from a source"
}
