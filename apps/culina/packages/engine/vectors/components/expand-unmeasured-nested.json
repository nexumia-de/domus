        "ref_id": "parsley"
      },
      {
        "path": ["dish", "sauce"],
        "index": 1,
        "ref_id": "salt"
      }
    ]
  },
  "tolerance": 0.000001,
  "source": "Sauce fraction 250 / 500 = 0.5: tomato 400 x 0.5 = 200; pasta 300; sum 500 g. Salt (sauce line 1) and parsley (dish line 2) have no amount and are listed, not guessed; a component reports its own unmeasured lines first, then its sub-components in line order."
