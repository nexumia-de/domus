      "steps": [
        {
          "text": {
            "en": "Chop the garlic and the chilli very finely.",
            "de": "Knoblauch und Chili sehr fein hacken."
          },
          "technique": "knife-cuts",
          "uses": ["garlic", "chili"]
        },
        {
          "text": {
            "en": "Warm the coconut milk and the water in a small pot over low heat and whisk in the peanut butter until the sauce is smooth.",
            "de": "Kokosmilch und Wasser in einem kleinen Topf bei schwacher Hitze erwärmen und die Erdnussbutter glatt einrühren."
          },
          "action": "whisk",
          "uses": ["coconut", "water", "peanut-butter"]
        },
        {
          "text": {
            "en": "Add the garlic, the chilli, the soy sauce and the sugar and simmer for 5 minutes, stirring often, until the sauce is thick enough to coat a spoon.",
            "de": "Knoblauch, Chili, Sojasauce und Zucker dazugeben und 5 Minuten köcheln lassen, dabei oft rühren, bis die Sauce einen Löffel überzieht."
          },
          "technique": "simmer",
          "uses": ["garlic", "chili", "soy", "sugar"],
          "time": {
            "value": 5,
            "unit": "min"
          }
        },
        {
          "text": {
            "en": "Take the pot off the heat, stir in the lime juice and taste. If the sauce is too thick, loosen it with a little warm water.",
            "de": "Den Topf vom Herd nehmen, den Limettensaft einrühren und abschmecken. Ist die Sauce zu dick, mit etwas warmem Wasser verdünnen."
          },
          "action": "remove-from-heat",
          "uses": ["lime"]
        },
        {
          "text": {
            "en": "Serve warm or at room temperature, for example with grilled skewers.",
            "de": "Warm oder zimmerwarm servieren, zum Beispiel zu gegrillten Spießen."
          },
          "action": "serve"
        }
      ]
    }
