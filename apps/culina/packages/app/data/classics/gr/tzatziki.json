      "steps": [
        {
          "text": {
            "en": "Peel the cucumber, cut it in half lengthwise and scrape out the seeds with a spoon. Grate it coarsely.",
            "de": "Die Gurke schälen, der Länge nach halbieren und die Kerne mit einem Löffel herauskratzen. Grob raspeln."
          },
          "action": "grate",
          "uses": ["cucumber"]
        },
        {
          "text": {
            "en": "Mix the grated cucumber with half of the salt and let it stand, then squeeze it out firmly in a clean kitchen towel or a sieve, so the dip stays thick.",
            "de": "Die Gurkenraspel mit der Hälfte des Salzes mischen, stehen lassen und dann in einem sauberen Küchentuch oder Sieb kräftig ausdrücken, damit der Dip dick bleibt."
          },
          "action": "stand",
          "uses": ["cucumber", "salt"],
          "time": {
            "value": 10,
            "unit": "min"
          }
        },
        {
          "text": {
            "en": "Crush the garlic or chop it very finely and chop the dill.",
            "de": "Den Knoblauch pressen oder sehr fein hacken und den Dill hacken."
          },
          "action": "prepare",
          "uses": ["garlic", "dill"]
        },
        {
          "text": {
            "en": "Stir the yogurt smooth with the olive oil and the vinegar, then fold in the cucumber, the garlic, the dill and the rest of the salt.",
            "de": "Den Joghurt mit Olivenöl und Essig glatt rühren, dann Gurke, Knoblauch, Dill und das übrige Salz unterheben."
          },
          "action": "mix",
          "uses": ["yogurt", "oil", "vinegar", "cucumber", "garlic", "dill", "salt"]
        },
        {
          "text": {
            "en": "Chill the dip for at least 1 hour so the garlic and dill come through, and taste it again before serving.",
            "de": "Den Dip mindestens 1 Stunde kalt stellen, damit Knoblauch und Dill durchziehen, und vor dem Servieren noch einmal abschmecken."
          },
          "action": "chill",
          "time": {
            "value": 1,
            "unit": "h"
          }
        }
      ]
    }
  ],
