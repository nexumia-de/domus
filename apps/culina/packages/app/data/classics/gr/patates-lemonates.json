      "steps": [
        {
          "text": {
            "en": "Preheat the oven to 200 °C (top and bottom heat).",
            "de": "Den Ofen auf 200 °C (Ober- und Unterhitze) vorheizen."
          },
          "action": "preheat",
          "temperature": {
            "value": 200,
            "unit": "C"
          }
        },
        {
          "text": {
            "en": "Peel the potatoes and cut them lengthwise into wedges of one size.",
            "de": "Die Kartoffeln schälen und längs in gleich große Spalten schneiden."
          },
          "technique": "knife-cuts",
          "uses": ["potatoes"]
        },
        {
          "text": {
            "en": "Chop the garlic finely. In a roasting tin large enough to hold the potatoes in one layer, mix the potatoes with the olive oil, the lemon juice, the garlic, the oregano, the salt and the pepper.",
            "de": "Den Knoblauch fein hacken. In einem Bräter, in dem die Kartoffeln in einer Lage Platz haben, die Kartoffeln mit Olivenöl, Zitronensaft, Knoblauch, Oregano, Salz und Pfeffer mischen."
          },
          "action": "mix",
          "uses": ["potatoes", "oil", "lemon", "garlic", "salt", "oregano", "pepper"]
        },
        {
          "text": {
            "en": "Pour the water into the tin beside the potatoes.",
            "de": "Das Wasser neben den Kartoffeln in den Bräter gießen."
          },
          "action": "pour",
          "uses": ["water"]
        },
        {
          "text": {
            "en": "Roast for 60 to 70 minutes and turn the potatoes once after half the time. They are done when they are soft, the edges are browned and almost all the liquid is gone.",
            "de": "60 bis 70 Minuten im Ofen braten und die Kartoffeln nach der Hälfte der Zeit einmal wenden. Sie sind fertig, wenn sie weich sind, die Ränder gebräunt sind und die Flüssigkeit fast ganz verkocht ist."
          },
