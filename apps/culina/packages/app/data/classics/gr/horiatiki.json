          "uses": ["tomato", "cucumber", "greenpepper"]
        },
        {
          "text": {
            "en": "Cut the onion into thin rings.",
            "de": "Die Zwiebel in dünne Ringe schneiden."
          },
          "technique": "knife-cuts",
          "uses": ["onion"]
        },
        {
          "text": {
            "en": "Put the vegetables and the olives in a wide bowl, add the salt and half of the olive oil and turn them gently.",
            "de": "Gemüse und Oliven in eine weite Schüssel geben, Salz und die Hälfte des Olivenöls zugeben und vorsichtig wenden."
          },
          "action": "mix",
          "uses": ["tomato", "cucumber", "onion", "greenpepper", "olives", "salt", "oil"]
        },
        {
          "text": {
            "en": "Lay the slab of feta on top, sprinkle it with the oregano and drizzle the rest of the olive oil over it. Serve at once, with bread to mop up the juices.",
            "de": "Die Fetascheibe obenauf legen, mit dem Oregano bestreuen und das restliche Olivenöl darüberträufeln. Sofort servieren, mit Brot zum Auftunken des Safts."
          },
          "action": "serve",
          "uses": ["feta", "oregano", "oil"]
        }
