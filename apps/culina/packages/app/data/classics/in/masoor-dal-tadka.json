          "amount": {
            "value": 0.5,
            "unit": "tsp"
          }
        }
      ],
      "steps": [
        {
          "text": {
            "en": "Heat the ghee in a small pan over medium heat.",
            "de": "Das Ghee in einer kleinen Pfanne bei mittlerer Hitze erhitzen."
          },
          "action": "heat",
          "uses": ["ghee"]
        },
        {
          "text": {
            "en": "Add the cumin seeds and let them sizzle for 30 seconds until they smell nutty.",
            "de": "Den Kreuzkümmel dazugeben und 30 Sekunden brutzeln lassen, bis er nussig duftet."
          },
          "action": "add",
          "uses": ["cumin"],
          "time": {
            "value": 30,
            "unit": "s"
          }
        },
        {
          "text": {
            "en": "Cook the onion in it for 6 minutes, stirring, until golden.",
            "de": "Die Zwiebel darin unter Rühren 6 Minuten goldgelb braten."
          },
          "action": "cook",
          "uses": ["onion"],
          "time": {
            "value": 6,
            "unit": "min"
          }
        },
        {
          "text": {
            "en": "Add the garlic and cook for 1 minute until it turns light golden.",
            "de": "Den Knoblauch dazugeben und 1 Minute braten, bis er hellgolden wird."
          },
          "action": "add",
          "uses": ["garlic"],
          "time": {
            "value": 1,
            "unit": "min"
          }
        },
        {
          "text": {
            "en": "Take the pan off the heat and stir in the cayenne pepper. Use the tempering at once.",
            "de": "Die Pfanne vom Herd nehmen und den Cayennepfeffer einrühren. Das Tadka sofort verwenden."
          },
          "action": "remove-from-heat",
          "uses": ["cayenne"]
        }
      ]
    }
