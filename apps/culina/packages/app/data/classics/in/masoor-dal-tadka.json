          },
          "note": {
            "en": "Roughly chopped.",
            "de": "Grob gehackt."
          }
        }
      ],
      "steps": [
        {
          "text": {
            "en": "Wash the lentils in a sieve under cold water.",
            "de": "Die Linsen in einem Sieb unter kaltem Wasser waschen."
          },
          "action": "wash",
          "uses": ["lentils"]
        },
        {
          "text": {
            "en": "Bring the lentils to the boil with the water, the turmeric and the ginger, and take off the foam that rises.",
            "de": "Die Linsen mit dem Wasser, Kurkuma und Ingwer aufkochen und den aufsteigenden Schaum abnehmen."
          },
          "action": "heat",
          "uses": ["lentils", "water", "turmeric", "ginger"]
        },
        {
          "text": {
            "en": "Add the tomato and simmer, half covered, for 20 minutes until the lentils fall apart; stir now and then.",
            "de": "Die Tomate dazugeben und halb zugedeckt 20 Minuten köcheln lassen, bis die Linsen zerfallen; ab und zu umrühren."
          },
          "technique": "simmer",
          "uses": ["tomato"],
          "time": {
            "value": 20,
            "unit": "min"
          }
        },
        {
          "text": {
            "en": "Stir in the salt and the lemon juice. For a thinner dal, stir in a little hot water.",
            "de": "Salz und Zitronensaft einrühren. Für ein dünneres Dal etwas heißes Wasser einrühren."
          },
          "action": "season",
          "uses": ["salt", "lemon"]
        },
        {
          "text": {
            "en": "Pour the tempering over the dal, scatter the coriander leaves on top and serve.",
            "de": "Das Tadka über das Dal gießen, das Koriandergrün darüberstreuen und anrichten."
          },
          "action": "serve",
          "uses": ["coriander"]
        }
      ]
    },
