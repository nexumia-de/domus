      ],
      "steps": [
        {
          "text": {
            "en": "Heat the oil in a wide pot over medium heat.",
            "de": "Das Öl in einem breiten Topf bei mittlerer Hitze erhitzen."
          },
          "action": "heat",
          "uses": ["oil"]
        },
        {
          "text": {
            "en": "Cook the onions in it for 12 minutes, stirring often, until golden brown.",
            "de": "Die Zwiebeln darin unter häufigem Rühren 12 Minuten goldbraun braten."
          },
          "action": "cook",
          "uses": ["onion"],
          "time": {
            "value": 12,
            "unit": "min"
          }
        },
        {
          "text": {
            "en": "Add the garlic and the ginger and stir for 1 minute.",
            "de": "Knoblauch und Ingwer dazugeben und 1 Minute rühren."
          },
          "action": "add",
          "uses": ["garlic", "ginger"],
          "time": {
            "value": 1,
            "unit": "min"
          }
        },
        {
          "text": {
            "en": "Stir in the ground coriander, the cumin, the turmeric and the cayenne pepper for 30 seconds.",
            "de": "Gemahlenen Koriander, Kreuzkümmel, Kurkuma und Cayennepfeffer 30 Sekunden einrühren."
          },
          "action": "season",
          "uses": ["coriander-seed", "cumin", "turmeric", "cayenne"],
          "time": {
            "value": 30,
            "unit": "s"
          }
        },
        {
          "text": {
            "en": "Add the tomatoes and the salt and cook for 10 minutes, stirring now and then, until the tomatoes have broken down into a thick sauce and the oil shows at the edge. Stir in the cinnamon and the cardamom.",
            "de": "Tomaten und Salz dazugeben und unter gelegentlichem Rühren 10 Minuten garen, bis die Tomaten zu einer dicken Sauce zerfallen sind und sich am Rand das Öl zeigt. Zimt und Kardamom einrühren."
          },
          "action": "cook",
          "uses": ["tomato", "salt", "cinnamon", "cardamom"],
          "time": {
            "value": 10,
            "unit": "min"
          }
        }
      ]
    },
    {
      "id": "murgh-chicken",
      "name": {
        "en": "Chicken",
        "de": "Hähnchen"
      },
      "role": "main",
      "lines": [
        {
          "key": "chicken",
          "ref": {
            "kind": "ingredient",
            "id": "fdc-173627"
          },
          "amount": {
            "value": 600,
            "unit": "g"
          },
          "note": {
            "en": "Thigh meat, without bone and skin, in pieces of about 3 cm.",
            "de": "Keulenfleisch ohne Knochen und Haut, in etwa 3 cm großen Stücken."
          }
        },
        {
          "key": "yogurt",
          "ref": {
            "kind": "ingredient",
            "id": "fdc-171284"
          },
          "amount": {
            "value": 150,
            "unit": "g"
          },
          "note": {
            "en": "Plain yogurt, for the marinade.",
            "de": "Naturjoghurt, für die Marinade."
          }
        },
        {
          "key": "water",
          "ref": {
            "kind": "ingredient",
            "id": "fdc-173647"
          },
          "amount": {
            "value": 150,
            "unit": "ml"
          }
        },
        {
          "key": "coriander",
          "ref": {
            "kind": "ingredient",
            "id": "fdc-169997"
          },
          "amount": {
            "value": 10,
            "unit": "g"
          },
          "note": {
            "en": "Chopped.",
            "de": "Gehackt."
          }
        }
      ],
      "steps": [
        {
          "text": {
            "en": "Mix the chicken with the yogurt and leave it covered in the fridge for 30 minutes.",
            "de": "Das Hähnchen mit dem Joghurt vermengen und zugedeckt 30 Minuten im Kühlschrank ziehen lassen."
          },
          "technique": "marinate",
          "uses": ["chicken", "yogurt"],
          "time": {
            "value": 30,
            "unit": "min"
          }
        },
        {
          "text": {
            "en": "Add the marinated chicken to the sauce and stir over medium heat for 5 minutes until the pieces are coated and no longer pink on the outside.",
            "de": "Das marinierte Hähnchen in die Sauce geben und bei mittlerer Hitze 5 Minuten rühren, bis die Stücke überzogen und außen nicht mehr rosa sind."
          },
          "action": "add",
          "uses": ["chicken"],
          "time": {
            "value": 5,
            "unit": "min"
          }
        },
        {
          "text": {
            "en": "Pour in the water, bring to the boil, cover and simmer gently for 20 minutes until the chicken is cooked through.",
            "de": "Das Wasser zugießen, aufkochen, zudecken und 20 Minuten leise köcheln lassen, bis das Hähnchen durchgegart ist."
          },
          "technique": "simmer",
          "uses": ["water"],
          "time": {
            "value": 20,
            "unit": "min"
          }
        },
        {
          "text": {
            "en": "Take the lid off and let the sauce cook down for 5 minutes until it coats the meat.",
            "de": "Den Deckel abnehmen und die Sauce 5 Minuten einkochen lassen, bis sie das Fleisch überzieht."
          },
          "technique": "reduce",
          "time": {
            "value": 5,
            "unit": "min"
          }
        },
        {
          "text": {
            "en": "Scatter the coriander leaves on top and serve with rice or flatbread.",
            "de": "Das Koriandergrün darüberstreuen und mit Reis oder Fladenbrot anrichten."
          },
          "action": "serve",
          "uses": ["coriander"]
        }
      ]
    }
