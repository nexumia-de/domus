      "steps": [
        {
          "text": {
            "en": "Soak the chickpeas in plenty of cold water overnight, at least 8 hours, then drain them.",
            "de": "Die Kichererbsen über Nacht, mindestens 8 Stunden, in reichlich kaltem Wasser einweichen, dann abgießen."
          },
          "action": "soak",
          "uses": ["chickpeas"],
          "time": {
            "value": 8,
            "unit": "h"
          }
        },
        {
          "text": {
            "en": "Cook the chickpeas in fresh water with the salt for the cooking water for about 60 minutes until soft, then drain them and keep them.",
            "de": "Die Kichererbsen in frischem Wasser mit dem Salz für das Kochwasser etwa 60 Minuten weich kochen, dann abgießen und beiseitestellen."
          },
          "technique": "simmer",
          "uses": ["soak-water", "salt-water"],
          "time": {
            "value": 60,
            "unit": "min"
          }
        },
        {
          "text": {
            "en": "Heat the oil in a wide pot over medium heat and let the cumin seeds sizzle in it for 30 seconds.",
            "de": "Das Öl in einem breiten Topf bei mittlerer Hitze erhitzen und den Kreuzkümmel darin 30 Sekunden brutzeln lassen."
          },
          "action": "heat",
          "uses": ["oil", "cumin"],
          "time": {
            "value": 30,
            "unit": "s"
          }
        },
        {
          "text": {
            "en": "Cook the onions for 10 minutes, stirring often, until golden brown.",
            "de": "Die Zwiebeln unter häufigem Rühren 10 Minuten goldbraun braten."
          },
          "action": "cook",
          "uses": ["onion"],
          "time": {
            "value": 10,
            "unit": "min"
          }
        },
        {
          "text": {
            "en": "Add the garlic, the ginger and the chilli and stir for 1 minute.",
            "de": "Knoblauch, Ingwer und Chili dazugeben und 1 Minute rühren."
          },
          "action": "add",
          "uses": ["garlic", "ginger", "chilli"],
          "time": {
            "value": 1,
            "unit": "min"
          }
        },
        {
          "text": {
            "en": "Stir in the ground coriander and the turmeric for 30 seconds.",
            "de": "Gemahlenen Koriander und Kurkuma 30 Sekunden einrühren."
          },
          "action": "season",
          "uses": ["coriander-seed", "turmeric"],
          "time": {
            "value": 30,
            "unit": "s"
          }
        },
        {
          "text": {
            "en": "Add the tomatoes and the salt for the curry and cook for 10 minutes until they have broken down into a thick paste.",
            "de": "Tomaten und das Salz für das Curry dazugeben und 10 Minuten garen, bis sie zu einer dicken Paste zerfallen sind."
          },
          "action": "cook",
          "uses": ["tomato", "salt"],
          "time": {
            "value": 10,
            "unit": "min"
          }
        },
        {
          "text": {
            "en": "Add the chickpeas and the water for the curry, bring to the boil and simmer for 15 minutes; press a few chickpeas against the pot with the spoon to thicken the sauce.",
            "de": "Kichererbsen und das Wasser für das Curry dazugeben, aufkochen und 15 Minuten köcheln lassen; einige Kichererbsen mit dem Löffel am Topf zerdrücken, damit die Sauce bindet."
          },
          "technique": "simmer",
          "uses": ["chickpeas", "curry-water"],
          "time": {
            "value": 15,
            "unit": "min"
          }
        },
        {
          "text": {
            "en": "Stir in the cinnamon, the cardamom and the lemon juice, scatter the coriander leaves on top and serve with rice or flatbread.",
            "de": "Zimt, Kardamom und Zitronensaft einrühren, das Koriandergrün darüberstreuen und mit Reis oder Fladenbrot anrichten."
          },
          "action": "serve",
          "uses": ["cinnamon", "cardamom", "lemon", "fresh-coriander"]
        }
      ]
    }
  ],
