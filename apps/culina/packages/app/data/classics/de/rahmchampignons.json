      "steps": [
        {
          "text": {
            "en": "Wipe the mushrooms clean and cut them into slices. Dice the onion finely.",
            "de": "Die Champignons trocken putzen und in Scheiben schneiden. Die Zwiebel fein würfeln."
          },
          "action": "prepare",
          "uses": ["mushrooms", "onion"]
        },
        {
          "text": {
            "en": "Melt the butter in a wide pan over high heat.",
            "de": "Die Butter in einer weiten Pfanne bei starker Hitze schmelzen."
          },
          "action": "melt",
          "uses": ["butter"]
        },
        {
          "text": {
            "en": "Fry the mushrooms in two batches, stirring now and then, until their liquid has cooked away and they begin to brown. Return all of them to the pan.",
            "de": "Die Champignons in zwei Portionen unter gelegentlichem Rühren braten, bis ihre Flüssigkeit verkocht ist und sie zu bräunen beginnen. Alle wieder in die Pfanne geben."
          },
          "technique": "saute",
          "uses": ["mushrooms"],
          "time": {
            "value": 8,
            "unit": "min"
          }
        },
        {
          "text": {
            "en": "Turn the heat down to medium, add the onion and cook it until translucent.",
            "de": "Die Hitze auf mittlere Stufe stellen, die Zwiebel dazugeben und glasig dünsten."
          },
          "action": "add",
          "uses": ["onion"],
          "time": {
            "value": 3,
            "unit": "min"
          }
        },
        {
          "text": {
            "en": "Pour in the cream.",
            "de": "Die Sahne angießen."
          },
          "action": "pour",
          "uses": ["cream"]
        },
        {
          "text": {
            "en": "Let the sauce bubble gently until it coats the mushrooms lightly.",
            "de": "Die Sauce leise einkochen lassen, bis sie die Champignons leicht überzieht."
          },
          "technique": "reduce",
          "time": {
            "value": 5,
            "unit": "min"
          }
        },
        {
          "text": {
            "en": "Season with the salt and the pepper and stir in the parsley.",
            "de": "Mit Salz und Pfeffer würzen und die Petersilie unterrühren."
          },
          "action": "season",
          "uses": ["salt", "pepper", "parsley"]
        }
      ]
    }
