      "steps": [
        {
          "text": {
            "en": "Butter a small heatproof bowl or mould of about 500 ml.",
            "de": "Eine kleine hitzefeste Schüssel oder Form von etwa 500 ml ausbuttern."
          },
          "action": "grease",
          "uses": ["butter"]
        },
        {
          "text": {
            "en": "Whisk the eggs with the milk, the salt and the nutmeg until even, without making foam.",
            "de": "Die Eier mit Milch, Salz und Muskat gleichmäßig verquirlen, ohne dass Schaum entsteht."
          },
          "action": "whisk",
          "uses": ["egg", "milk", "salt", "nutmeg"]
        },
        {
          "text": {
            "en": "Pour the mixture into the mould and cover it with foil.",
            "de": "Die Masse in die Form gießen und mit Folie abdecken."
          },
          "action": "fill"
        },
        {
          "text": {
            "en": "Set the mould in a pot of hot water that reaches halfway up and let it set for 25 to 30 minutes over low heat; the water must not boil.",
            "de": "Die Form in einen Topf mit heißem Wasser stellen, das bis zur halben Höhe reicht, und bei schwacher Hitze 25 bis 30 Minuten stocken lassen; das Wasser darf nicht kochen."
          },
          "technique": "water-bath",
          "time": {
            "value": 25,
            "to": 30,
            "unit": "min"
          }
        },
        {
          "text": {
            "en": "Let it cool a little, run a knife round the edge and turn it out.",
            "de": "Etwas abkühlen lassen, mit einem Messer am Rand entlangfahren und stürzen."
          },
          "action": "turn-out"
        },
        {
          "text": {
            "en": "Cut it into cubes or diamonds of 1.5 cm.",
            "de": "In Würfel oder Rauten von 1,5 cm schneiden."
          },
          "technique": "knife-cuts"
        }
      ]
    }
  ],
