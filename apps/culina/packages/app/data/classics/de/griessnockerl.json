      "steps": [
        {
          "text": {
            "en": "Stir the soft butter until creamy.",
            "de": "Die weiche Butter cremig rühren."
          },
          "action": "stir",
          "uses": ["butter"]
        },
        {
          "text": {
            "en": "Stir in the egg, then the semolina, the salt and the nutmeg, to a smooth dough.",
            "de": "Das Ei unterrühren, dann Grieß, Salz und Muskat zu einem glatten Teig verrühren."
          },
          "action": "mix",
          "uses": ["egg", "semolina", "salt", "nutmeg"]
        },
        {
          "text": {
            "en": "Cover and leave the dough in the fridge for 30 minutes, so that the semolina swells.",
            "de": "Den Teig zugedeckt 30 Minuten in den Kühlschrank stellen, damit der Grieß quillt."
          },
          "action": "stand",
          "time": {
            "value": 30,
            "unit": "min"
          }
        },
        {
          "text": {
            "en": "Bring the water with the salt for it to the boil in a wide pot, then turn the heat down until it barely moves.",
            "de": "Das Wasser mit dem Salz dafür in einem weiten Topf aufkochen, dann die Hitze reduzieren, bis es sich kaum noch bewegt."
          },
          "action": "heat",
          "uses": ["water", "salt-water"]
        },
        {
          "text": {
            "en": "With two teaspoons dipped in water, shape the dough into 12 small ovals and slide them into the water.",
            "de": "Mit zwei in Wasser getauchten Teelöffeln aus dem Teig 12 kleine Nocken formen und ins Wasser gleiten lassen."
          },
          "action": "shape"
        },
        {
          "text": {
            "en": "Cover and let them cook for 15 minutes without boiling, then leave them in the water off the heat for 5 minutes more.",
            "de": "Zugedeckt 15 Minuten garen, ohne dass das Wasser kocht, dann vom Herd genommen weitere 5 Minuten darin ziehen lassen."
          },
          "technique": "poach",
          "time": {
            "value": 15,
            "unit": "min"
          }
        },
        {
          "text": {
            "en": "Lift them out with a slotted spoon.",
            "de": "Mit einem Schaumlöffel herausheben."
          },
          "action": "take-out"
        }
      ]
    }
