      "steps": [
        {
          "text": {
            "en": "Wash the carrots, the celeriac and the leek and cut them into pieces of about 3 cm. Halve the onion with its skin.",
            "de": "Karotten, Sellerie und Lauch waschen und in etwa 3 cm große Stücke schneiden. Die Zwiebel mit der Schale halbieren."
          },
          "action": "prepare",
          "uses": ["carrot", "celeriac", "leek", "onion"]
        },
        {
          "text": {
            "en": "Heat the oil in a large pot and brown the onion halves, cut side down, over medium heat for 5 minutes, until dark brown.",
            "de": "Das Öl in einem großen Topf erhitzen und die Zwiebelhälften mit der Schnittfläche nach unten bei mittlerer Hitze 5 Minuten dunkelbraun anrösten."
          },
          "action": "cook",
          "uses": ["oil", "onion"],
          "time": {
            "value": 5,
            "unit": "min"
          }
        },
        {
          "text": {
            "en": "Add the vegetables, the parsley, the peppercorns and the cold water and bring slowly to the boil.",
            "de": "Gemüse, Petersilie, Pfefferkörner und das kalte Wasser dazugeben und langsam aufkochen."
          },
          "action": "pour",
          "uses": ["carrot", "celeriac", "leek", "parsley", "pepper", "water"]
        },
        {
          "text": {
            "en": "Turn the heat down and simmer, half covered, for 45 to 60 minutes.",
            "de": "Die Hitze reduzieren und halb zugedeckt 45 bis 60 Minuten köcheln lassen."
          },
          "technique": "simmer",
          "time": {
            "value": 45,
            "to": 60,
            "unit": "min"
          }
        },
        {
          "text": {
            "en": "Pour the broth through a fine sieve and press the vegetables lightly; discard them.",
            "de": "Die Brühe durch ein feines Sieb gießen, das Gemüse leicht ausdrücken und wegwerfen."
          },
          "action": "strain"
        },
        {
          "text": {
            "en": "Season with the salt. It makes about 1.5 litres.",
            "de": "Mit dem Salz abschmecken. Es ergibt etwa 1,5 Liter."
          },
          "action": "season",
          "uses": ["salt"]
        }
      ]
    }
  ],
