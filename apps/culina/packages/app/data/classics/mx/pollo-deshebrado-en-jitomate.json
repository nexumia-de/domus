      "steps": [
        {
          "text": {
            "en": "Put the chicken into a pot with the water and the salt for the cooking water.",
            "de": "Das Hähnchen mit dem Wasser und dem Salz für das Kochwasser in einen Topf geben."
          },
          "action": "add",
          "uses": ["chicken", "water", "salt-pot"]
        },
        {
          "text": {
            "en": "Bring to the boil, then cook gently with the lid on until the chicken is cooked through.",
            "de": "Aufkochen, dann zugedeckt sanft garen, bis das Hähnchen durch ist."
          },
          "action": "cook",
          "uses": ["chicken"],
          "time": {
            "value": 20,
            "unit": "min"
          }
        },
        {
          "text": {
            "en": "Take the chicken out and keep 150 ml of the cooking liquid.",
            "de": "Das Hähnchen herausnehmen und 150 ml der Kochflüssigkeit aufheben."
          },
          "action": "take-out",
          "uses": ["chicken"]
        },
        {
          "text": {
            "en": "Pull the meat into shreds with two forks.",
            "de": "Das Fleisch mit zwei Gabeln in Fasern zupfen."
          },
          "action": "prepare",
          "uses": ["chicken"]
        },
        {
          "text": {
            "en": "Blend the tomatoes, the garlic and the jalapeños to a purée.",
            "de": "Tomaten, Knoblauch und Jalapeños im Mixer pürieren."
          },
          "action": "puree",
          "uses": ["tomato", "garlic", "chilli"]
        },
        {
          "text": {
            "en": "Heat the oil in a wide pan and cook the onion over medium heat until soft.",
            "de": "Das Öl in einer weiten Pfanne erhitzen und die Zwiebel bei mittlerer Hitze weich garen."
          },
          "action": "cook",
          "uses": ["oil", "onion"],
          "time": {
            "value": 5,
            "unit": "min"
          }
        },
        {
          "text": {
            "en": "Pour in the purée and cook until it darkens and thickens a little.",
            "de": "Das Püree zugießen und garen, bis es dunkler wird und etwas eindickt."
          },
          "action": "pour",
          "uses": ["tomato"],
          "time": {
            "value": 5,
            "unit": "min"
          }
        },
        {
          "text": {
            "en": "Add the chicken, the 150 ml of cooking liquid, the cumin, the oregano and the salt for the sauce.",
            "de": "Das Hähnchen, die 150 ml Kochflüssigkeit, Kreuzkümmel, Oregano und das Salz für die Sauce dazugeben."
          },
          "action": "add",
          "uses": ["chicken", "cumin", "oregano", "salt-sauce"]
        },
        {
          "text": {
            "en": "Cook over low heat, stirring now and then, until the sauce clings to the meat.",
            "de": "Bei schwacher Hitze unter gelegentlichem Rühren garen, bis die Sauce am Fleisch haftet."
          },
          "action": "cook",
          "time": {
            "value": 10,
            "unit": "min"
          }
        }
      ]
    }
