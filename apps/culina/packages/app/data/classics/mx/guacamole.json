      "steps": [
        {
          "text": {
            "en": "Peel the onion and chop it finely; chop the jalapeño and the coriander leaves finely.",
            "de": "Die Zwiebel schälen und fein hacken; Jalapeño und Koriandergrün fein hacken."
          },
          "action": "prepare",
          "uses": ["onion", "chilli", "coriander"]
        },
        {
          "text": {
            "en": "Halve the avocados, remove the stones and scoop the flesh into a bowl.",
            "de": "Die Avocados halbieren, die Kerne entfernen und das Fruchtfleisch in eine Schüssel löffeln."
          },
          "action": "prepare",
          "uses": ["avocado"]
        },
        {
          "text": {
            "en": "Mash the avocado roughly with a fork; small pieces stay.",
            "de": "Die Avocado mit einer Gabel grob zerdrücken; kleine Stücke bleiben."
          },
          "action": "mash",
          "uses": ["avocado"]
        },
        {
          "text": {
            "en": "Stir in the onion, the jalapeño and the coriander.",
            "de": "Zwiebel, Jalapeño und Koriandergrün unterrühren."
          },
          "action": "stir",
          "uses": ["onion", "chilli", "coriander"]
        },
        {
          "text": {
            "en": "Squeeze the lime over it, add the salt and stir; add more salt if needed.",
            "de": "Die Limette darüber auspressen, das Salz zugeben und umrühren; bei Bedarf nachsalzen."
          },
          "action": "season",
          "uses": ["lime", "salt"]
        },
        {
          "text": {
            "en": "Serve at once, as the flesh turns brown when it stands.",
            "de": "Gleich servieren, denn das Fruchtfleisch wird beim Stehen braun."
          },
          "action": "serve"
        }
      ]
    }
  ],
