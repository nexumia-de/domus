      "steps": [
        {
          "text": {
            "en": "Stir the cornstarch with 2 tablespoons of the stock until smooth.",
            "de": "Die Stärke mit 2 Esslöffeln des Fonds glatt rühren."
          },
          "action": "stir",
          "uses": ["cornstarch", "stock"]
        },
        {
          "text": {
            "en": "Add the rest of the stock, the soy sauce, the oyster sauce, the sugar and the sesame oil and stir until the sugar has dissolved.",
            "de": "Den übrigen Fond, Sojasauce, Austernsauce, Zucker und Sesamöl zugeben und rühren, bis sich der Zucker gelöst hat."
          },
          "action": "mix",
          "uses": ["stock", "soy-sauce", "oyster-sauce", "sugar", "sesame-oil"]
        },
        {
          "text": {
            "en": "Stir again just before use, as the starch settles. Pour it into the wok at the end of stir-frying and cook for 1 minute, stirring, until it turns glossy and thickens.",
            "de": "Kurz vor Gebrauch noch einmal rühren, da sich die Stärke absetzt. Am Ende des Wok-Bratens in den Wok gießen und 1 Minute rührend kochen, bis sie glänzt und bindet."
          },
          "technique": "thicken-with-starch",
