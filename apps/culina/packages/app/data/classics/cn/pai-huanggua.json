      "steps": [
        {
          "text": {
            "en": "Lay the cucumbers on a board and hit them with the flat of a wide knife or a rolling pin until they split open.",
            "de": "Die Gurken auf ein Brett legen und mit der flachen Seite eines breiten Messers oder einem Nudelholz schlagen, bis sie aufplatzen."
          },
          "action": "crush",
          "uses": ["cucumber"]
        },
        {
          "text": {
            "en": "Cut or tear them into pieces of about 3 cm, mix them with the salt in a sieve and leave them to drain for 10 minutes.",
            "de": "In etwa 3 cm große Stücke schneiden oder brechen, in einem Sieb mit dem Salz mischen und 10 Minuten abtropfen lassen."
          },
          "action": "drain",
          "uses": ["cucumber", "salt"],
          "time": {
            "value": 10,
            "unit": "min"
          }
        },
        {
          "text": {
            "en": "Chop the garlic finely and stir it with the soy sauce, the vinegar, the sugar and the sesame oil until the sugar has dissolved.",
            "de": "Den Knoblauch fein hacken und mit Sojasauce, Essig, Zucker und Sesamöl verrühren, bis sich der Zucker gelöst hat."
          },
          "action": "mix",
          "uses": ["garlic", "soy-sauce", "vinegar", "sugar", "sesame-oil"]
        },
        {
          "text": {
            "en": "Shake the liquid off the cucumbers, toss them with the dressing and serve at once.",
            "de": "Die Flüssigkeit von den Gurken abschütteln, die Gurken mit der Sauce mischen und sofort servieren."
          },
          "action": "mix",
          "uses": ["cucumber"]
        }
      ]
    }
