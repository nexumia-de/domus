          },
          "temperature": {
            "value": 71,
            "unit": "C"
          }
        },
        {
          "text": {
            "en": "Let the patties stand on a plate before serving.",
            "de": "Die Patties vor dem Servieren auf einem Teller stehen lassen."
          },
          "action": "stand",
