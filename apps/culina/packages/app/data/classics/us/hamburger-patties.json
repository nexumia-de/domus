      "steps": [
        {
          "text": {
            "en": "Divide the beef into 4 portions of 150 g and shape each, without kneading, into a patty about 2 cm thick; press a shallow dent into the middle.",
            "de": "Das Hackfleisch in 4 Portionen von 150 g teilen und jede, ohne zu kneten, zu einem etwa 2 cm dicken Patty formen; in die Mitte eine flache Mulde drücken."
          },
          "action": "shape",
          "uses": ["beef"]
        },
        {
          "text": {
            "en": "Sprinkle both sides with the salt and the pepper just before frying.",
            "de": "Kurz vor dem Braten beide Seiten mit Salz und Pfeffer bestreuen."
          },
          "action": "season",
          "uses": ["salt", "pepper"]
        },
        {
          "text": {
            "en": "Heat the oil in a heavy pan over high heat.",
            "de": "Das Öl in einer schweren Pfanne bei starker Hitze erhitzen."
          },
          "action": "heat",
          "uses": ["oil"]
        },
        {
          "text": {
            "en": "Fry the patties without moving them until a brown crust has formed underneath.",
            "de": "Die Patties braten, ohne sie zu bewegen, bis sich unten eine braune Kruste gebildet hat."
          },
          "technique": "sear",
          "uses": ["beef"],
          "time": {
            "value": 3,
            "unit": "min"
          }
        },
        {
          "text": {
            "en": "Turn them and fry the other side; a patty is cooked through at 71 °C in the middle.",
            "de": "Wenden und die andere Seite braten; durchgegart ist ein Patty bei 71 °C im Kern."
          },
          "action": "turn",
          "uses": ["beef"],
          "time": {
            "value": 3,
            "to": 4,
