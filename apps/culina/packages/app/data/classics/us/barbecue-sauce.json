      "steps": [
        {
          "text": {
            "en": "Put the ketchup, the sugar, the vinegar, the Worcestershire sauce, the mustard, the water and all the spices into a small pot.",
            "de": "Ketchup, Zucker, Essig, Worcestershiresauce, Senf, Wasser und alle Gewürze in einen kleinen Topf geben."
          },
          "action": "add",
          "uses": [
            "ketchup",
            "brown-sugar",
            "vinegar",
            "worcestershire",
            "mustard",
            "water",
            "onion-powder",
            "garlic-powder",
            "paprika",
            "pepper",
            "salt"
          ]
        },
        {
          "text": {
            "en": "Stir until the sugar has dissolved.",
            "de": "Rühren, bis sich der Zucker aufgelöst hat."
          },
          "action": "stir",
          "uses": ["brown-sugar"]
        },
        {
          "text": {
            "en": "Bring to the boil, then simmer over low heat, stirring now and then, until the sauce is thick enough to coat a spoon.",
            "de": "Aufkochen, dann bei schwacher Hitze unter gelegentlichem Rühren köcheln lassen, bis die Sauce einen Löffel überzieht."
          },
          "technique": "simmer",
          "time": {
            "value": 15,
            "to": 20,
            "unit": "min"
          }
        },
        {
          "text": {
            "en": "Let the sauce cool; it thickens a little more as it cools.",
            "de": "Die Sauce abkühlen lassen; beim Abkühlen wird sie noch etwas dicker."
          },
          "action": "cool"
        }
      ]
    }
