            "unit": "g"
          },
          "note": {
            "en": "For the pan.",
            "de": "Für die Pfanne."
          }
        }
      ],
      "steps": [
        {
          "text": {
            "en": "Mix the flour, the sugar, the baking powder, the baking soda and the salt in a large bowl.",
            "de": "Mehl, Zucker, Backpulver, Natron und Salz in einer großen Schüssel mischen."
          },
          "action": "mix",
          "uses": ["flour", "sugar", "baking-powder", "baking-soda", "salt"]
        },
        {
          "text": {
            "en": "Whisk the buttermilk, the eggs and the melted butter in a second bowl.",
            "de": "Buttermilch, Eier und die geschmolzene Butter in einer zweiten Schüssel verquirlen."
          },
          "action": "whisk",
          "uses": ["buttermilk", "egg", "butter"]
        },
        {
          "text": {
            "en": "Pour the liquid onto the flour mixture and stir only until no dry flour is left; small lumps stay.",
            "de": "Die Flüssigkeit zur Mehlmischung gießen und nur so lange rühren, bis kein trockenes Mehl mehr zu sehen ist; kleine Klümpchen bleiben."
          },
          "action": "stir"
        },
        {
          "text": {
            "en": "Let the batter stand.",
            "de": "Den Teig stehen lassen."
          },
          "action": "stand",
          "time": {
            "value": 5,
            "unit": "min"
          }
        },
        {
          "text": {
            "en": "Heat a pan over medium heat and grease it thinly with a little of the butter for the pan.",
            "de": "Eine Pfanne bei mittlerer Hitze erhitzen und mit etwas Butter für die Pfanne dünn einfetten."
          },
          "action": "grease",
          "uses": ["butter-pan"]
        },
        {
          "text": {
            "en": "Pour in about 60 ml of batter for each pancake and cook until bubbles break on top and the edges look set.",
            "de": "Für jeden Pancake etwa 60 ml Teig hineingießen und backen, bis oben Blasen aufplatzen und die Ränder fest aussehen."
          },
          "action": "cook",
          "time": {
            "value": 2,
            "to": 3,
            "unit": "min"
          }
        },
        {
          "text": {
            "en": "Turn the pancakes and cook the second side until golden.",
            "de": "Die Pancakes wenden und die zweite Seite goldbraun backen."
          },
          "action": "turn",
          "time": {
            "value": 1,
            "to": 2,
            "unit": "min"
          }
        },
        {
          "text": {
            "en": "Cook the rest of the batter in the same way and serve the pancakes warm.",
            "de": "Den übrigen Teig ebenso backen und die Pancakes warm servieren."
          },
          "action": "serve"
        }
      ]
    }
  ],
