      "steps": [
        {
          "text": {
            "en": "Cut the onions, the peppers, the aubergine, the courgettes and the tomatoes into pieces of about 2 cm and slice the garlic.",
            "de": "Zwiebeln, Paprika, Aubergine, Zucchini und Tomaten in Stücke von etwa 2 cm schneiden und den Knoblauch in Scheiben schneiden."
          },
          "technique": "knife-cuts",
          "uses": [
            "onion",
            "pepper-red",
            "pepper-green",
            "aubergine",
            "courgette",
            "tomato",
            "garlic"
          ]
        },
        {
          "text": {
            "en": "Heat 2 tablespoons of the oil in a large wide pot and fry the aubergine over medium heat for 8 minutes, stirring now and then, until it is golden. Take it out.",
            "de": "2 Esslöffel des Öls in einem großen, weiten Topf erhitzen und die Aubergine bei mittlerer Hitze 8 Minuten braten, dabei gelegentlich rühren, bis sie goldgelb ist. Herausnehmen."
          },
          "technique": "pan-fry",
          "uses": ["oil", "aubergine"],
          "time": {
            "value": 8,
            "unit": "min"
          }
        },
        {
          "text": {
            "en": "Add 2 more tablespoons of oil and fry the courgettes for 5 minutes until they are lightly coloured. Take them out as well.",
            "de": "Weitere 2 Esslöffel Öl zugeben und die Zucchini 5 Minuten braten, bis sie leicht Farbe haben. Ebenfalls herausnehmen."
          },
          "technique": "pan-fry",
          "uses": ["oil", "courgette"],
          "time": {
            "value": 5,
            "unit": "min"
          }
        },
        {
          "text": {
            "en": "Heat the last tablespoon of oil and cook the onions and the peppers over medium heat for 8 minutes until soft.",
            "de": "Den letzten Esslöffel Öl erhitzen und Zwiebeln und Paprika bei mittlerer Hitze 8 Minuten weich garen."
          },
          "technique": "sweat",
          "uses": ["oil", "onion", "pepper-red", "pepper-green"],
          "time": {
            "value": 8,
            "unit": "min"
          }
        },
        {
          "text": {
            "en": "Add the garlic, the tomatoes, the thyme, the salt and the pepper and cook for 5 minutes until the tomatoes release their juice.",
            "de": "Knoblauch, Tomaten, Thymian, Salz und Pfeffer zugeben und 5 Minuten garen, bis die Tomaten Saft lassen."
          },
          "action": "add",
          "uses": ["garlic", "tomato", "thyme", "salt", "pepper"],
          "time": {
            "value": 5,
            "unit": "min"
          }
        },
        {
          "text": {
            "en": "Return the aubergine and the courgettes to the pot, cover and simmer over low heat for 30 minutes, stirring now and then. Take off the lid for the last 10 minutes if the vegetables are too wet.",
            "de": "Aubergine und Zucchini in den Topf zurückgeben, zugedeckt bei schwacher Hitze 30 Minuten schmoren, dabei gelegentlich rühren. Sind die Gemüse zu nass, in den letzten 10 Minuten ohne Deckel garen."
          },
          "technique": "simmer",
          "uses": ["aubergine", "courgette"],
          "time": {
            "value": 30,
            "unit": "min"
          }
        },
        {
          "text": {
            "en": "Taste, adjust the salt and serve warm or at room temperature.",
            "de": "Abschmecken, nach Bedarf nachsalzen und warm oder zimmerwarm servieren."
          },
          "action": "taste",
          "uses": ["salt"]
        }
      ]
    }
  ],
