      "steps": [
        {
          "text": {
            "en": "Crush the garlic, the salt and the pine nuts to a paste in a mortar, or chop them finely in a blender.",
            "de": "Knoblauch, Salz und Pinienkerne im Mörser zu einer Paste zerstoßen oder im Mixer fein hacken."
          },
          "action": "crush",
          "uses": ["garlic", "salt", "pine-nuts"]
        },
        {
          "text": {
            "en": "Add the basil leaves a handful at a time and crush them until the paste is green and even; in a blender work in short bursts so that the leaves stay cool.",
            "de": "Die Basilikumblätter handvollweise dazugeben und zerreiben, bis die Paste grün und gleichmäßig ist; im Mixer in kurzen Stößen arbeiten, damit die Blätter kühl bleiben."
          },
          "action": "crush",
          "uses": ["basil"]
        },
        {
          "text": {
            "en": "Stir in the parmesan and the pecorino.",
            "de": "Parmesan und Pecorino unterrühren."
          },
          "action": "stir",
          "uses": ["parmesan", "pecorino"]
        },
        {
          "text": {
            "en": "Stir in the oil a little at a time until the pesto is creamy.",
            "de": "Das Öl nach und nach unterrühren, bis das Pesto cremig ist."
          },
          "action": "stir",
          "uses": ["oil"]
        },
        {
          "text": {
            "en": "Use the pesto cold: for pasta, loosen it with 2 to 3 tablespoons of the cooking water and toss it with the drained pasta off the heat. The amount dresses 400 g of dry pasta.",
            "de": "Das Pesto kalt verwenden: für Nudeln mit 2 bis 3 Esslöffeln Kochwasser verdünnen und abseits vom Herd mit den abgegossenen Nudeln mischen. Die Menge reicht für 400 g trockene Nudeln."
          },
          "action": "serve"
        }
      ]
    }
