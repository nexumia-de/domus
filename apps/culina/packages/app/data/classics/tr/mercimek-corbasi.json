          "key": "lemon",
          "ref": {
            "kind": "ingredient",
            "id": "fdc-167747"
          },
          "amount": {
            "value": 2,
            "unit": "tbsp"
          },
          "note": {
            "en": "At the table, each to their own liking.",
            "de": "Bei Tisch, jeder nach Belieben."
          }
        }
      ],
      "steps": [
        {
          "text": {
            "en": "Chop the onion and the carrot. Rinse the lentils in a sieve under cold water.",
            "de": "Zwiebel und Möhre klein würfeln. Die Linsen in einem Sieb kalt abspülen."
          },
          "action": "prepare",
          "uses": ["onion", "carrot", "lentils"]
        },
        {
          "text": {
            "en": "Melt the butter in a large pot and cook the onion and the carrot in it over medium heat for about 5 minutes, without colour.",
            "de": "Die Butter in einem großen Topf schmelzen und Zwiebel und Möhre darin bei mittlerer Hitze etwa 5 Minuten dünsten, ohne dass sie Farbe nehmen."
          },
          "technique": "sweat",
          "uses": ["butter", "onion", "carrot"],
          "time": {
            "value": 5,
            "unit": "min"
          }
        },
        {
          "text": {
            "en": "Stir in the tomato paste and the cumin, then add the lentils and the water.",
            "de": "Das Tomatenmark und den Kreuzkümmel einrühren, dann die Linsen und das Wasser dazugeben."
          },
          "action": "add",
          "uses": ["paste", "cumin", "lentils", "water"]
        },
        {
          "text": {
            "en": "Bring to the boil, then cook at a gentle simmer, half covered, for 25 to 30 minutes, until the lentils fall apart. Stir now and then.",
            "de": "Aufkochen, dann halb zugedeckt 25 bis 30 Minuten leise köcheln lassen, bis die Linsen zerfallen. Ab und zu umrühren."
          },
          "technique": "simmer",
          "time": {
            "value": 25,
            "to": 30,
            "unit": "min"
          }
        },
        {
          "text": {
            "en": "Purée the soup with a hand blender until smooth and season it with the salt and the pepper. If it is thicker than you like, stir in a little hot water.",
            "de": "Die Suppe mit dem Stabmixer glatt pürieren und mit Salz und Pfeffer würzen. Ist sie dicker als gewünscht, etwas heißes Wasser einrühren."
          },
          "action": "puree",
          "uses": ["salt", "pepper"]
        },
        {
          "text": {
            "en": "Serve the soup with the lemon juice beside it.",
            "de": "Die Suppe anrichten und den Zitronensaft dazu reichen."
          },
          "action": "serve",
          "uses": ["lemon"]
        }
      ]
    },
