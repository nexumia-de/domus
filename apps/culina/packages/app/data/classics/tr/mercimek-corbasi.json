      "steps": [
        {
          "text": {
            "en": "Melt the butter in a small pan over low heat until it foams.",
            "de": "Die Butter in einem kleinen Topf bei schwacher Hitze schmelzen, bis sie schäumt."
          },
          "action": "melt",
          "uses": ["butter"]
        },
        {
          "text": {
            "en": "Take it off the heat and stir in the paprika and the mint; the spices darken quickly in hot butter.",
            "de": "Vom Herd nehmen und Paprikapulver und Minze einrühren; die Gewürze werden in heißer Butter schnell dunkel."
          },
          "action": "stir",
          "uses": ["paprika", "mint"]
        },
        {
          "text": {
            "en": "Drizzle the butter over the soup in the plates.",
            "de": "Die Butter in den Tellern über die Suppe träufeln."
          },
          "action": "garnish"
        }
      ]
    }
