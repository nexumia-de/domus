      "steps": [
        {
          "text": {
            "en": "Melt the butter in a wide pan over medium-low heat.",
            "de": "Die Butter in einer breiten Pfanne bei mittlerer bis schwacher Hitze schmelzen."
          },
          "action": "melt",
          "uses": ["butter"]
        },
        {
          "text": {
            "en": "Cook the onions in it for 25 minutes, stirring now and then, until they are soft and deep golden brown.",
            "de": "Die Zwiebeln darin unter gelegentlichem Rühren 25 Minuten garen, bis sie weich und tief goldbraun sind."
          },
          "action": "cook",
          "uses": ["onion"],
          "time": {
            "value": 25,
            "unit": "min"
          }
        },
        {
          "text": {
            "en": "Sprinkle the flour over the onions and stir for 2 minutes.",
            "de": "Das Mehl über die Zwiebeln streuen und 2 Minuten rühren."
          },
          "action": "sprinkle",
          "uses": ["flour"],
          "time": {
            "value": 2,
            "unit": "min"
          }
        },
        {
          "text": {
            "en": "Pour in the hot stock a little at a time, stirring so that no lumps form.",
            "de": "Die heiße Brühe nach und nach zugießen und dabei rühren, damit keine Klümpchen entstehen."
          },
          "action": "pour",
          "uses": ["stock"]
        },
        {
          "text": {
            "en": "Add the Worcestershire sauce and simmer for 10 minutes until the gravy coats the back of a spoon.",
            "de": "Die Worcestershiresauce zugeben und 10 Minuten köcheln lassen, bis die Sauce den Löffelrücken überzieht."
          },
          "technique": "simmer",
          "uses": ["worcestershire"],
          "time": {
            "value": 10,
            "unit": "min"
          }
        },
        {
          "text": {
            "en": "Season with the pepper and serve hot with sausages, mash or roast meat.",
            "de": "Mit dem Pfeffer abschmecken und heiß zu Würstchen, Püree oder Braten servieren."
          },
          "action": "season",
          "uses": ["pepper"]
        }
      ]
