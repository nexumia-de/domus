{
  "id": "invite-parse",
  "kind": "invite-parse",
  "description": "parseInvite (takes a parsed value, not text): a minimal invite; with name; with access; with both. Unknown fields are ignored, inside storage too (the result has only the known fields); access is kept when its keys and values are right. Errors: not-an-invite for non-objects and other formats; older-version for version 1 (a place invite, not read); newer-version for a version above 2 (checked first); invalid for any other version, a secret that is not 43 base64url characters, a name that is not text, a broken storage (type breaks its rule, empty or missing address, missing), and an access that is not an object of text values with keys of the stated form.",
  "source": "docs/sync.md",
  "cases": [
    {
      "name": "minimal",
      "input": {
        "value": {
          "format": "materia-invite",
          "version": 2,
          "secret": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
          "storage": {
            "type": "webdav",
            "address": "https://dav.example.org/domus/"
          }
        }
      },
      "expected": {
        "ok": true,
        "invite": {
          "format": "materia-invite",
          "version": 2,
          "secret": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
          "storage": {
            "type": "webdav",
            "address": "https://dav.example.org/domus/"
          }
        }
      }
    },
    {
      "name": "with name",
      "input": {
        "value": {
          "format": "materia-invite",
          "version": 2,
          "secret": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
          "storage": {
            "type": "webdav",
            "address": "https://dav.example.org/domus/"
          },
          "name": "Home"
        }
      },
      "expected": {
        "ok": true,
        "invite": {
          "format": "materia-invite",
          "version": 2,
          "secret": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
          "storage": {
            "type": "webdav",
            "address": "https://dav.example.org/domus/"
          },
          "name": "Home"
        }
      }
    },
    {
      "name": "with access",
      "input": {
        "value": {
          "format": "materia-invite",
          "version": 2,
          "secret": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
          "storage": {
            "type": "webdav",
            "address": "https://dav.example.org/domus/"
          },
          "access": {
            "token": "ghp_abc"
          }
        }
      },
      "expected": {
        "ok": true,
        "invite": {
          "format": "materia-invite",
          "version": 2,
          "secret": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
          "storage": {
            "type": "webdav",
            "address": "https://dav.example.org/domus/"
          },
          "access": {
            "token": "ghp_abc"
          }
        }
      }
    },
    {
      "name": "with name and access",
      "input": {
        "value": {
          "format": "materia-invite",
          "version": 2,
          "secret": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
          "storage": {
            "type": "webdav",
            "address": "https://dav.example.org/domus/"
          },
          "name": "Home",
          "access": {
            "token": "t",
            "userName": "u"
          }
        }
      },
      "expected": {
        "ok": true,
        "invite": {
          "format": "materia-invite",
          "version": 2,
          "secret": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
          "storage": {
            "type": "webdav",
            "address": "https://dav.example.org/domus/"
          },
          "name": "Home",
          "access": {
            "token": "t",
            "userName": "u"
          }
        }
      }
    },
    {
      "name": "empty access is kept",
      "input": {
        "value": {
          "format": "materia-invite",
          "version": 2,
          "secret": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
          "storage": {
            "type": "webdav",
            "address": "https://dav.example.org/domus/"
          },
          "access": {}
        }
      },
      "expected": {
        "ok": true,
        "invite": {
          "format": "materia-invite",
          "version": 2,
          "secret": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
          "storage": {
            "type": "webdav",
            "address": "https://dav.example.org/domus/"
          },
          "access": {}
        }
      }
    },
    {
      "name": "secret with every kind of character",
      "input": {
        "value": {
          "format": "materia-invite",
          "version": 2,
          "secret": "abcdefghijklmnopqrstuvwxyz0123456789_-ABCDE",
          "storage": {
            "type": "webdav",
            "address": "https://dav.example.org/domus/"
          }
        }
      },
      "expected": {
        "ok": true,
        "invite": {
          "format": "materia-invite",
          "version": 2,
          "secret": "abcdefghijklmnopqrstuvwxyz0123456789_-ABCDE",
          "storage": {
            "type": "webdav",
            "address": "https://dav.example.org/domus/"
          }
        }
      }
    },
    {
      "name": "unknown fields ignored, also inside storage",
      "input": {
        "value": {
          "format": "materia-invite",
          "version": 2,
          "secret": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
          "storage": {
            "type": "webdav",
            "address": "https://dav.example.org/domus/",
            "region": "x"
          },
          "extra": 1
        }
      },
      "expected": {
        "ok": true,
        "invite": {
          "format": "materia-invite",
          "version": 2,
          "secret": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
          "storage": {
            "type": "webdav",
            "address": "https://dav.example.org/domus/"
          }
        }
      }
    },
    {
      "name": "a string",
      "input": {
        "value": "invite"
      },
      "expected": {
        "ok": false,
        "error": "not-an-invite"
      }
    },
    {
      "name": "an array",
