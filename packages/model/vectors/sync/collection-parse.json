    {
      "name": "prunedBefore of another type",
      "input": {
        "json": {
          "format": "materia-collection",
          "version": 1,
          "space": "s1",
          "collection": "stock",
          "records": [],
          "prunedBefore": 5
        }
      },
      "expected": {
        "ok": false,
        "error": "invalid"
      }
    }
  ]
}
