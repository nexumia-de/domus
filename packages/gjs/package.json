{
  "name": "@nexumia-de/gjs",
  "version": "0.1.0",
  "private": true,
  "description": "What the native Linux apps (GTK 4, libadwaita, GJS) share: the Web Crypto subset, fetch on libsoup, files, joining a space by link, the build and the check tooling",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tooling/build": "./tooling/build.mjs",
    "./tooling/smoke": "./tooling/smoke.mjs",
    "./tooling/seed": "./tooling/seed.mjs",
    "./tooling/interact-lib": "./tooling/interact-lib.mjs",
    "./tooling/interact-pixels": "./tooling/interact-pixels.mjs",
    "./node-files": "./src/node-files.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@nexumia-de/hospes": "0.1.0",
    "@nexumia-de/materia": "0.3.0",
    "@noble/ciphers": "2.4.0",
    "@noble/hashes": "2.4.0"
  }
}
