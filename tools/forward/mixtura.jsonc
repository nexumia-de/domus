{
  // Replaces the worker that served the app at mixtura.nexumia.de; the custom
  // domain stays attached to the worker of this name.
  "name": "mixtura",
  "main": "./forward.js",
  "compatibility_date": "2026-11-18",
  "vars": { "TARGET": "https://domus.nexumia.de/mixtura" },
  "routes": [{ "pattern": "mixtura.nexumia.de", "custom_domain": true }],
}
